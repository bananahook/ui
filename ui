local function AttachTooltip(Inst, GetText)
    GiveSignal(Inst.MouseEnter:Connect(function()
        local Text = GetText()
        if Text and Text ~= "" then
            TooltipLabel.Text = Text
            TooltipLabel.Visible = true
        end
    end))
    GiveSignal(Inst.MouseLeave:Connect(function()
        TooltipLabel.Visible = false
    end))
    GiveSignal(Inst.InputChanged:Connect(function(IO)
        if TooltipLabel.Visible then
            local ScaleV = Scale.Scale
            TooltipLabel.Position = UDim2.fromOffset(
                IO.Position.X / ScaleV + 14,
                IO.Position.Y / ScaleV + 16
            )
        end
    end))
end

-- // ------------------------------------------------------------- dragging

local function MakeDraggable(DragSurface, Target, IsMainWindow)
    local Dragging, DragInput, StartPos, StartPoint

    GiveSignal(DragSurface.InputBegan:Connect(function(IO)
        if IsMainWindow and Library.CantDrag then
            return
        end
        if IO.UserInputType == Enum.UserInputType.MouseButton1
        or IO.UserInputType == Enum.UserInputType.Touch then
            Dragging = true
            StartPoint = IO.Position
            StartPos = Target.Position
            IO.Changed:Connect(function()
                if IO.UserInputState == Enum.UserInputState.End then
                    Dragging = false
                end
            end)
        end
    end))
    GiveSignal(DragSurface.InputChanged:Connect(function(IO)
        if IO.UserInputType == Enum.UserInputType.MouseMovement
        or IO.UserInputType == Enum.UserInputType.Touch then
            DragInput = IO
        end
    end))
    GiveSignal(UserInputService.InputChanged:Connect(function(IO)
        if IO.UserInputType == Enum.UserInputType.MouseMovement
        or IO.UserInputType == Enum.UserInputType.Touch then
            if Dragging and DragInput then
                local Delta = IO.Position - StartPoint
                Target.Position = UDim2.new(
                    StartPos.X.Scale, StartPos.X.Offset + Delta.X,
                    StartPos.Y.Scale, StartPos.Y.Offset + Delta.Y
                )
            end
        end
    end))
end

-- // ------------------------------------------------------------- window
--
-- obsidian's exact chrome: a 48px title bar with the icon + 20px title
-- centered over the sidebar, current-tab info + search box on the right,
-- a 30% wide (15,15,15) sidebar with 40px tab rows, a (17,17,17) content
-- area and a 20px footer bar (23,23,23) with centered footer text. the
-- window is clamped to the viewport like obsidian so it always fits.

local TOPBAR_H = 48
local FOOTER_H = 20

local CurrentWindow

-- obsidian's viewport clamping: never bigger than viewport - 64
local function ClampToViewport(Size)
    local ViewW, ViewH = 1920, 1080
    pcall(function()
        local Cam = workspace.CurrentCamera
        if Cam then
            local VP = Cam.ViewportSize
            ViewW, ViewH = VP.X, VP.Y
        end
    end)
    local MaxW = math.max(240, ViewW - 64)
    local MaxH = math.max(200, ViewH - 64)
    local MinW = math.min(480, MaxW)
    local MinH = math.min(360, MaxH)
    local W = Clamp(Size.X.Offset, MinW, MaxW)
    local H = Clamp(Size.Y.Offset, MinH, MaxH)
    return UDim2.fromOffset(W, H)
end

function Library:CreateWindow(Info)
    Library:InitRoot()
    Info = Info or {}

    local Window = {}
    Window.Tabs = {}
    Window.AlwaysOnTop = Info.AlwaysOnTop == true
    Window.Resizable = Info.Resizable == true
    Window.Title = Info.Title or "obsidian"
    Window.Footer = Info.Footer or ""
    Window.Icon = Info.Icon
    Window.TabCount = 0
    CurrentWindow = Window

    local Size = ClampToViewport(Info.Size or UDim2.fromOffset(648, 540))
    local SidebarW = math.ceil(Size.X.Offset * 0.3)

    -- main frame: one step darker than the background, like obsidian's
    -- GetBetterColor(BackgroundColor, -1)
    local Frame = New("TextButton", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = Info.Position or UDim2.fromScale(0.5, 0.5),
        Size = Size,
        BackgroundColor3 = Library.Scheme.WindowColor,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = "",
        ClipsDescendants = true,
        Parent = Wrapper,
    })
    Window.Frame = Frame
    Window.Size = Size
    Window.SidebarW = SidebarW
    RegCorner(Frame, Library.CornerRadius)
    local FrameStroke = New("UIStroke", { Thickness = 1, Parent = Frame })
    S(FrameStroke, "Color", "OutlineColor")
    local WindowScale = New("UIScale", { Scale = 1, Parent = Frame })
    Window.Scale = WindowScale

    -- title bar: 48px, full width, drags the window (obsidian's TopBar) ---
    local TopBar = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, TOPBAR_H),
        ZIndex = 4,
        Parent = Frame,
    })
    MakeDraggable(TopBar, Frame, true)
    local TopLine = New("Frame", {
        BackgroundColor3 = Library.Scheme.OutlineColor,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(0, TOPBAR_H),
        Size = UDim2.new(1, 0, 0, 1),
        ZIndex = 4,
        Parent = Frame,
    })
    S(TopLine, "BackgroundColor3", "OutlineColor")

    -- brand block: banana png + two-tone title, centered over the sidebar
    local TitleHolder = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(0, SidebarW, 0, TOPBAR_H),
        ZIndex = 5,
        Parent = TopBar,
    })
    New("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        Padding = UDim.new(0, 6),
        Parent = TitleHolder,
    })

    local Logo
    if Info.Icon == false then
        Logo = nil
    elseif type(Info.Icon) == "number" or type(Info.Icon) == "string" then
        Logo = New("ImageLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(30, 30),
            Image = (type(Info.Icon) == "number")
                and ("rbxassetid://" .. tostring(Info.Icon))
                or tostring(Info.Icon),
            ZIndex = 6,
            Parent = TitleHolder,
        })
    else
        Logo = MakeBanana(30)
        Logo.ZIndex = 6
        Logo.Parent = TitleHolder
    end
    Window.Logo = Logo

    -- one-line two-tone brand: "banana" in white + "hook" in the accent,
    -- rendered through rich text so both colors coexist on the same line
    local BrandMain = Info.Title or "obsidian"
    local BrandAccent = type(Info.TitleAccent) == "string" and Info.TitleAccent or ""

    local function ColorHex(Color)
        return string.format("#%02X%02X%02X",
            math.floor(Color.R * 255 + 0.5),
            math.floor(Color.G * 255 + 0.5),
            math.floor(Color.B * 255 + 0.5))
    end
    local function EscapeRich(Text)
        Text = tostring(Text or "")
        Text = Text:gsub("&", "&amp;")
        Text = Text:gsub("<", "&lt;")
        Text = Text:gsub(">", "&gt;")
        return Text
    end

    local BrandText = New("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 0, 0, 24),
        AutomaticSize = Enum.AutomaticSize.X,
        Font = F.Brand,
        TextSize = 20,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
        RichText = true,
        Text = "",
        ZIndex = 6,
        Parent = TitleHolder,
    })

    local function RefreshBrand()
        local Text = '<font color="' .. ColorHex(Library.Scheme.FontColor) .. '">'
            .. EscapeRich(BrandMain) .. "</font>"
        if BrandAccent ~= "" then
            Text = Text .. '<font color="' .. ColorHex(Library.Scheme.AccentColor) .. '">'
                .. EscapeRich(BrandAccent) .. "</font>"
        end
        BrandText.Text = Text
    end
    RefreshBrand()
    table.insert(Library.StateUpdaters, function()
        pcall(RefreshBrand)
    end)
