-- // ------------------------------------------------------------------ slider

local function CreateSlider(Container, Idx, Info)
    Idx, Info = NormalizeArgs(Idx, Info)
    Info = Info or {}

    local Min = Info.Min or 0
    local Max = Info.Max or 100
    if Min > Max then
        Min, Max = Max, Min
    end
    local Rounding = Info.Rounding or 0
    local Compact = Info.Compact == true

    local RowObj = CreateRow(Container, Info, Compact and 16 or 30, 6)
    local Object = MakeElementObject(RowObj, Idx, false)
    Object.Type = "Slider"
    Object.Info = Info
    Object.Min = Min
    Object.Max = Max

    local Value = Clamp(tonumber(Info.Default) or Min, Min, Max)
    Object.Value = Value

    -- skeet layout: [label][1px divider][value] on the first line, bar below
    local Head = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 12),
        Parent = RowObj.Frame,
    })
    New("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 4),
        Parent = Head,
    })
    RowObj.Title.Size = UDim2.new(0, 0, 1, 0)
    RowObj.Title.AutomaticSize = Enum.AutomaticSize.X
    RowObj.Title.TextXAlignment = Enum.TextXAlignment.Left
    RowObj.Title.Parent = Head
    local HeadDiv = New("Frame", {
        Size = UDim2.fromOffset(1, 8),
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        Parent = Head,
    })
    S(HeadDiv, "BackgroundColor3", "DarkText")
    local ValueLabel = New("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 0, 1, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        Font = F.Row,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "",
        Parent = Head,
    })
    S(ValueLabel, "TextColor3", "DarkText")

    local Bar, Fill
    if not Compact then
        Bar = New("Frame", {
            BackgroundColor3 = Library.Scheme.Background,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 0, 0, 16),
            Size = UDim2.new(1, 0, 0, 12),
            Parent = RowObj.Frame,
        })
        New("UICorner", { CornerRadius = UDim.new(0, 3), Parent = Bar })
        local BarStroke = New("UIStroke", { Thickness = 1, Parent = Bar })
        S(BarStroke, "Color", "Border")
        Fill = New("Frame", {
            BackgroundColor3 = Library.Scheme.Accent,
            BackgroundTransparency = 0.25,
            BorderSizePixel = 0,
            Position = UDim2.fromOffset(1, 1),
            Size = UDim2.new(0, 0, 1, -2),
            Parent = Bar,
        })
        New("UICorner", { CornerRadius = UDim.new(0, 2), Parent = Fill })
        S(Fill, "BackgroundColor3", "Accent")
    end

    local function GetPct()
        return (Object.Value - Min) / math.max(Max - Min, 0.001)
    end

    function Object:FormatValue(V)
        if type(Info.FormatDisplayValue) == "function" then
            local Custom = Info.FormatDisplayValue(self, V)
            if type(Custom) == "string" then
                return Custom
            end
        end
        local Text = string.format("%." .. Rounding .. "f", V)
        if Info.Suffix then
            Text = Text .. tostring(Info.Suffix)
        end
        if Info.ShowMax == true then
            Text = Text .. " / " .. string.format("%." .. Rounding .. "f", Max) .. tostring(Info.Suffix or "")
        end
        return Text
    end

    function Object:UpdateVisual()
        local Pct = Clamp(GetPct(), 0, 1)
        if Fill then
            Fill.Size = UDim2.new(Pct, -2, 1, -2)
            if Pct <= 0.001 then
                Fill.Size = UDim2.new(0, 0, 1, -2)
            end
        end
        ValueLabel.Text = self:FormatValue(self.Value)
    end

    function Object:SetValue(NewValue, Silent)
        NewValue = Clamp(Round(tonumber(NewValue) or Min, Rounding), Min, Max)
        if math.abs(NewValue - self.Value) < (0.1 ^ Rounding) / 2 then
            self:UpdateVisual()
            return
        end
        self.Value = NewValue
        self:UpdateVisual()
        if not Silent then
            FireElement(self, NewValue)
        end
    end

    table.insert(Library.StateUpdaters, function()
        pcall(function() Object:UpdateVisual() end)
    end)

    if Bar then
        local Dragging = false
        local function SetValueFromX(X)
            local Rel = (X - Bar.AbsolutePosition.X) / math.max(Bar.AbsoluteSize.X, 1)
            Rel = Clamp(Rel, 0, 1)
            Object:SetValue(Min + (Max - Min) * Rel)
        end

        GiveSignal(Bar.InputBegan:Connect(function(IO)
            if RowObj.Disabled then
                return
            end
            if IO.UserInputType == Enum.UserInputType.MouseButton1
            or IO.UserInputType == Enum.UserInputType.Touch then
                Dragging = true
                SetValueFromX(IO.Position.X)
            end
        end))
        GiveSignal(UserInputService.InputChanged:Connect(function(IO)
            if Dragging and (IO.UserInputType == Enum.UserInputType.MouseMovement
            or IO.UserInputType == Enum.UserInputType.Touch) then
                SetValueFromX(IO.Position.X)
            end
        end))
        GiveSignal(UserInputService.InputEnded:Connect(function(IO)
            if IO.UserInputType == Enum.UserInputType.MouseButton1
            or IO.UserInputType == Enum.UserInputType.Touch then
                Dragging = false
            end
        end))
    end

    Object:UpdateVisual()
    return Object
end

