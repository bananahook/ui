        })
        local Glow = New("Frame", {
            BackgroundColor3 = Library.Scheme.Accent,
            BackgroundTransparency = 0.86,
            BorderSizePixel = 0,
            Position = UDim2.fromOffset(-3, -2),
            Size = UDim2.new(1, 6, 1, 4),
            ZIndex = 8,
            Parent = RowFrame,
        })
        New("UICorner", { CornerRadius = UDim.new(0, 6), Parent = Glow })
        S(Glow, "BackgroundColor3", "Accent")
        local Border = New("Frame", {
            BackgroundColor3 = Library.Scheme.Border,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 1, 0),
            ZIndex = 9,
            Parent = RowFrame,
        })
        New("UICorner", { CornerRadius = UDim.new(0, 4), Parent = Border })
        S(Border, "BackgroundColor3", "Border")
        local Inside = New("Frame", {
            BackgroundColor3 = Library.Scheme.Background,
            BackgroundTransparency = 0.2,
            BorderSizePixel = 0,
            Position = UDim2.fromOffset(1, 1),
            Size = UDim2.new(1, -2, 1, -2),
            ZIndex = 10,
            Parent = RowFrame,
        })
        New("UICorner", { CornerRadius = UDim.new(0, 4), Parent = Inside })
        S(Inside, "BackgroundColor3", "Background")
        local Icon = MakeBanana(10)
        Icon.Position = UDim2.fromOffset(3, 3)
        Icon.ZIndex = 11
        Icon.Parent = Inside
        local Label = New("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(17, 0),
            Size = UDim2.new(0, 0, 1, 0),
            AutomaticSize = Enum.AutomaticSize.X,
            Font = F.Row,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = "",
            TextColor3 = Library.Scheme.ActiveText,
            ZIndex = 11,
            Parent = Inside,
        })
        S(Label, "TextColor3", "ActiveText")
        New("UIPadding", { PaddingRight = UDim.new(0, 5), Parent = RowFrame })
        return {
            Frame = RowFrame,
            Glow = Glow,
            Icon = Icon,
            Label = Label,
        }
    end

    function Library:UpdateKeybindFrame()
        if not Library.KeybindFrame then
            return
        end
        while #Rows < #Library.KeybindEntries do
            table.insert(Rows, MakeBindRow())
        end

        local AnyVisible = false
        local VisibleIndex = 0
        for I, Entry in ipairs(Library.KeybindEntries) do
            local Row = Rows[I]
            local Active = Entry.GetState()
            local Show = not Library.KeybindMenu.VisibilityControl or Active
            Row.Label.Text = tostring(Entry.Name)
            if Show then
                VisibleIndex = VisibleIndex + 1
                local Y = 24 + (VisibleIndex - 1) * 21
                if not Row.Frame.Visible then
                    -- slide in from the left, juju style
                    Row.Frame.Position = UDim2.fromOffset(-5, Y)
                    Row.Frame.Visible = true
                    Tween(Row.Frame, 0.15, { Position = UDim2.fromOffset(0, Y) },
                        Enum.EasingStyle.Circular)
                else
                    Row.Frame.Position = UDim2.fromOffset(0, Y)
                end
                AnyVisible = true
            else
                Row.Frame.Visible = false
            end
            -- dim the icon + glow for inactive rows
            local IconAlpha = Active and 0 or 0.5
            for _, Seg in ipairs(Row.Icon:GetChildren()) do
                if Seg:IsA("Frame") then
                    Seg.BackgroundTransparency = IconAlpha
                end
            end
            Row.Glow.BackgroundTransparency = Active and 0.86 or 0.96
            Row.Label.TextColor3 = Active and Library.Scheme.ActiveText or Library.Scheme.InactiveText
        end
        Panel.Visible = AnyVisible and #Library.KeybindEntries > 0
    end
end

