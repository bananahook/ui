        S(WTopCover, "BackgroundColor3", "Section")
        local WTick = New("Frame", {
            BackgroundColor3 = Library.Scheme.Red,
            BackgroundTransparency = 0.5,
            BorderSizePixel = 0,
            Position = UDim2.fromOffset(1, 0),
            Size = UDim2.fromOffset(9, 1),
