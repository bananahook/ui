-- color registry: instances tagged with a scheme key get recolored by SetScheme
Library.ColorRegistry = {}
Library.StateUpdaters = {}     -- functions re-applying scheme to stateful colors

local function S(Inst, Prop, Key)
    Library.ColorRegistry[Inst] = Library.ColorRegistry[Inst] or {}
    Library.ColorRegistry[Inst][Prop] = Key
    local Ok = pcall(function()
        Inst[Prop] = Library.Scheme[Key]
    end)
    if not Ok then
        Library.ColorRegistry[Inst][Prop] = nil
    end
    return Inst
end

function Library:SetScheme(Patch)
    for K, V in pairs(Patch or {}) do
        Library.Scheme[K] = V
        -- keep the paired aliases in sync so both key styles work
        if K == "Accent" then Library.Scheme.Yellow = V
        elseif K == "Yellow" then Library.Scheme.Accent = V
        elseif K == "Background" then Library.Scheme.WindowBackground = V
        elseif K == "Section" then
            Library.Scheme.GroupboxBackground = V
            Library.Scheme.GroupboxHeader = V
            Library.Scheme.TitleBar = V
            Library.Scheme.TabRow = V
        elseif K == "Border" then
            Library.Scheme.GroupboxBorder = V
            Library.Scheme.InputBorder = V
            Library.Scheme.CheckBorder = V
            Library.Scheme.Separator = V
            Library.Scheme.NotificationBorder = V
            Library.Scheme.ScrollBar = V
            Library.Scheme.StrokeColor = V
        end
    end
    for Inst, Props in pairs(Library.ColorRegistry) do
        if Inst.Parent then
            for Prop, Key in pairs(Props) do
                pcall(function()
                    Inst[Prop] = Library.Scheme[Key]
                end)
            end
        else
            Library.ColorRegistry[Inst] = nil
        end
    end
    for _, Updater in ipairs(Library.StateUpdaters) do
        pcall(Updater)
    end
end

-- back-compat alias used by some hub scripts
function Library:UpdateColorsUsingRegistry()
    Library:SetScheme({})
end

