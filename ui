local function CreateLabel(Container, A, B, C)
    local Text, DoesWrap, Idx
    if type(A) == "table" then
        Idx, Text, DoesWrap = B, A.Text or tostring(A), A.DoesWrap
    elseif type(A) == "string" and type(B) == "table" then
        Idx, Text, DoesWrap = A, B.Text or "", B.DoesWrap
    else
        Text, DoesWrap, Idx = A, B, C
    end

    local Info = { Text = Text or "" }
    local RowObj = CreateRow(Container, Info, 14, 6)
    local Object = MakeElementObject(RowObj, Idx, false)
    Object.Type = "Label"

    RowObj.Title.TextWrapped = DoesWrap == true
    if DoesWrap then
        RowObj.Title.Size = UDim2.new(1, 0, 0, 0)
        RowObj.Title.AutomaticSize = Enum.AutomaticSize.Y
        RowObj.Title.TextYAlignment = Enum.TextYAlignment.Top
        RowObj.Frame.Size = UDim2.new(1, 0, 0, 0)
        RowObj.Frame.AutomaticSize = Enum.AutomaticSize.Y
    end

    function Object:SetText(NewText)
        RowObj:SetText(NewText)
    end

    function Object:AddColorPicker(CPIdx, CPInfo)
        AttachColorPicker(self, RowObj, CPIdx, CPInfo)
        return self
    end

    function Object:AddKeyPicker(KPIdx, KPInfo)
        AttachKeyPicker(self, RowObj, KPIdx, KPInfo)
        return self
    end

    return Object
end

