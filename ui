AttachColorPicker = function(ParentObject, RowObj, Idx, Info)
    Info = Info or {}

    local Object = MakeElementObject(RowObj, Idx, false)
    Object.Type = "Colorpicker"
    Object.Info = Info
    Object.Value = Info.Default or Color3.fromRGB(255, 255, 255)
    Object.Transparency = Info.Transparency or 0

    -- skeet swatch: small 12x12 color square on the row's right
    local Swatch = New("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Size = UDim2.fromOffset(12, 12),
        BackgroundColor3 = Object.Value,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 2,
        Parent = RowObj.Frame,
    })
    New("UICorner", { CornerRadius = UDim.new(0, 2), Parent = Swatch })
    local SStroke = New("UIStroke", { Thickness = 1, Parent = Swatch })
    S(SStroke, "Color", "Border")

    -- right-side addons must clear the obsidian switch (32px + gap) on
    -- toggle rows; checkboxes keep the old 18px base
    local Base = 2
    if ParentObject.Type == "Toggle" then
        Base = 41
    elseif ParentObject.Type == "Checkbox" then
        Base = 18
    end
    local Margin = Base + (RowObj.ControlOffset or 0)
    RowObj.ControlOffset = (RowObj.ControlOffset or 0) + 18
    RowObj:AddControl(Swatch, Margin)

    local function UpdateSwatch()
        Swatch.BackgroundColor3 = Object.Value
    end

    function Object:SetValueRGB(Color, Silent)
        self.Value = Color3.new(
            Clamp(Color.R, 0, 1), Clamp(Color.G, 0, 1), Clamp(Color.B, 0, 1))
        UpdateSwatch()
        if not Silent then
            FireElement(self, self.Value)
        end
    end

    function Object:SetValueHSV(H, S, V, Silent)
        self.Value = Color3.fromHSV(Clamp(H, 0, 1), Clamp(S, 0, 1), Clamp(V, 0, 1))
        UpdateSwatch()
        if not Silent then
            FireElement(self, self.Value)
        end
    end

    function Object:SetTransparency(Value, Silent)
        self.Transparency = Clamp(Value, 0, 1)
        if not Silent then
            FireElement(self, self.Value)
        end
    end

    GiveSignal(Swatch.MouseButton1Click:Connect(function()
        local AbsPos, AbsSize = Swatch.AbsolutePosition, Swatch.AbsoluteSize
        Library:ClosePopup()
        local Hue, Sat, Val = Object.Value:ToHSV()

        -- skeet popup: SV square + vertical hue bar (+ alpha bar), black panel
        local Popup = New("Frame", {
            BackgroundColor3 = Library.Scheme.Background,
            BorderSizePixel = 0,
            Size = UDim2.fromOffset(146, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            ZIndex = 51,
        })
        New("UICorner", { CornerRadius = UDim.new(0, 4), Parent = Popup })
        local PStroke = New("UIStroke", { Thickness = 1, Parent = Popup })
        S(PStroke, "Color", "Border")
        New("UIPadding", {
            PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
            PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
            Parent = Popup,
        })

        if Info.Title then
            local PT = New("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 12),
                Font = F.Row,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = tostring(Info.Title),
                LayoutOrder = 0,
                Parent = Popup,
            })
            S(PT, "TextColor3", "InactiveText")
        end

        local Row = New("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 110),
            LayoutOrder = 1,
            Parent = Popup,
        })
        New("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            Padding = UDim.new(0, 5),
            Parent = Row,
        })

        -- saturation / value square
        local Square = New("TextButton", {
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0,
            Size = UDim2.fromOffset(110, 110),
            Text = "",
            AutoButtonColor = false,
            Parent = Row,
        })
        local Grad = New("UIGradient", {
            Rotation = 0,
            Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromHSV(Hue, 1, 1)),
            Parent = Square,
        })
        local Darken = New("Frame", {
            BackgroundColor3 = Color3.new(0, 0, 0),
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 1, 0),
            Parent = Square,
        })
        New("UIGradient", {
            Rotation = 90,
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(1, 0),
            }),
            Color = ColorSequence.new(Color3.new(0, 0, 0), Color3.new(0, 0, 0)),
            Parent = Darken,
        })
        local Cursor = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(Sat, 0, 1 - Val, 0),
            Size = UDim2.fromOffset(8, 8),
            BackgroundTransparency = 1,
            ZIndex = 2,
            Parent = Square,
        })
        New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Cursor })
        New("UIStroke", { Thickness = 2, Color = Color3.new(1, 1, 1), Parent = Cursor })

        -- vertical bars column
        local Bars = New("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -115, 1, 0),
            Parent = Row,
        })
        New("UIListLayout", {
            Padding = UDim.new(0, 4),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = Bars,
        })

        local HueBar = New("TextButton", {
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 60),
            Text = "",
            AutoButtonColor = false,
            LayoutOrder = 1,
            Parent = Bars,
        })
        New("UICorner", { CornerRadius = UDim.new(0, 3), Parent = HueBar })
        New("UIGradient", {
            Rotation = 90,
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
                ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
                ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
                ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
                ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
                ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
                ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
            }),
            Parent = HueBar,
        })
        local HueCursor = New("Frame", {
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 0, Hue, 0),
            Size = UDim2.new(1, 0, 0, 2),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0,
            ZIndex = 2,
            Parent = HueBar,
        })
        New("UICorner", { CornerRadius = UDim.new(0, 1), Parent = HueCursor })

        local TransparencyBar, TransCursor
        if Info.Transparency ~= nil then
            TransparencyBar = New("TextButton", {
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 24),
                Text = "",
                AutoButtonColor = false,
                LayoutOrder = 2,
                Parent = Bars,
            })
            New("UICorner", { CornerRadius = UDim.new(0, 3), Parent = TransparencyBar })
            New("UIGradient", {
                Rotation = 90,
                Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0),
                    NumberSequenceKeypoint.new(1, 1),
                }),
                Parent = TransparencyBar,
            })
            TransCursor = New("Frame", {
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 0, Object.Transparency, 0),
                Size = UDim2.new(1, 0, 0, 2),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
                ZIndex = 2,
                Parent = TransparencyBar,
            })
            New("UICorner", { CornerRadius = UDim.new(0, 1), Parent = TransCursor })
        end

        local function Refresh()
            Grad.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromHSV(Hue, 1, 1))
            Cursor.Position = UDim2.new(Sat, 0, 1 - Val, 0)
            HueCursor.Position = UDim2.new(0, 0, Hue, 0)
            Object:SetValueHSV(Hue, Sat, Val)
            if TransparencyBar then
                TransCursor.Position = UDim2.new(0, 0, Object.Transparency, 0)
            end
        end

        local function BindDrag(Bar, Callback)
            local Dragging = false
            GiveSignal(Bar.InputBegan:Connect(function(IO)
                if IO.UserInputType == Enum.UserInputType.MouseButton1
                or IO.UserInputType == Enum.UserInputType.Touch then
                    Dragging = true
                    local Rel = (IO.Position.Y - Bar.AbsolutePosition.Y) / math.max(Bar.AbsoluteSize.Y, 1)
                    Callback(Clamp(Rel, 0, 1))
                end
            end))
            GiveSignal(UserInputService.InputChanged:Connect(function(IO)
                if Dragging and (IO.UserInputType == Enum.UserInputType.MouseMovement
                or IO.UserInputType == Enum.UserInputType.Touch) then
                    local Rel = (IO.Position.Y - Bar.AbsolutePosition.Y) / math.max(Bar.AbsoluteSize.Y, 1)
                    Callback(Clamp(Rel, 0, 1))
                end
            end))
            GiveSignal(UserInputService.InputEnded:Connect(function(IO)
                if IO.UserInputType == Enum.UserInputType.MouseButton1
                or IO.UserInputType == Enum.UserInputType.Touch then
                    Dragging = false
                end
            end))
        end

        BindDrag(HueBar, function(Rel)
            Hue = Rel
            Refresh()
        end)
        if TransparencyBar then
            BindDrag(TransparencyBar, function(Rel)
                Object:SetTransparency(Rel)
                Refresh()
            end)
        end
        do
            local Dragging = false
            GiveSignal(Square.InputBegan:Connect(function(IO)
                if IO.UserInputType == Enum.UserInputType.MouseButton1
                or IO.UserInputType == Enum.UserInputType.Touch then
                    Dragging = true
                    local RX = (IO.Position.X - Square.AbsolutePosition.X) / math.max(Square.AbsoluteSize.X, 1)
                    local RY = (IO.Position.Y - Square.AbsolutePosition.Y) / math.max(Square.AbsoluteSize.Y, 1)
                    Sat = Clamp(RX, 0, 1)
                    Val = 1 - Clamp(RY, 0, 1)
                    Refresh()
                end
            end))
            GiveSignal(UserInputService.InputChanged:Connect(function(IO)
                if Dragging and (IO.UserInputType == Enum.UserInputType.MouseMovement
                or IO.UserInputType == Enum.UserInputType.Touch) then
                    local RX = (IO.Position.X - Square.AbsolutePosition.X) / math.max(Square.AbsoluteSize.X, 1)
                    local RY = (IO.Position.Y - Square.AbsolutePosition.Y) / math.max(Square.AbsoluteSize.Y, 1)
                    Sat = Clamp(RX, 0, 1)
                    Val = 1 - Clamp(RY, 0, 1)
                    Refresh()
                end
            end))
            GiveSignal(UserInputService.InputEnded:Connect(function(IO)
                if IO.UserInputType == Enum.UserInputType.MouseButton1
                or IO.UserInputType == Enum.UserInputType.Touch then
                    Dragging = false
                end
            end))
        end

        OpenPopupAtRect(Popup, AbsPos, AbsSize)
    end))

    UpdateSwatch()
    return Object
end

-- // ------------------------------------------------------------ key picker

Library.Keybinds = {}
Library.KeybindEntries = {}
Library.ListeningKeybind = nil

local ModeOrder = { "Toggle", "Hold", "Press", "Always" }

AttachKeyPicker = function(ParentObject, RowObj, Idx, Info)
    Info = Info or {}

    local Object = MakeElementObject(RowObj, Idx, false)
    Object.Type = "Keybind"
    Object.Info = Info
    Object.Mode = Info.Mode or "Toggle"
    Object.SyncToggleState = Info.SyncToggleState == true
    Object.State = false
    Object.Modifiers = nil

    local Default = Info.Default
    if type(Default) == "string" then
        Object.Value = Default
    elseif typeof and typeof(Default) == "EnumItem" then
        if Default.EnumType == Enum.KeyCode then
            Object.Value = Default.Name
        else
            Object.Value = GetKeyName(nil, Default)
        end
    elseif Default == nil then
        Object.Value = "NONE"
    else
        Object.Value = tostring(Default)
    end

    -- skeet chip: right-aligned compact box showing just the key name
    local Chip = New("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Size = UDim2.fromOffset(0, 12),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundColor3 = Library.Scheme.Background,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Font = F.Row,
        TextSize = 12,
        Text = "",
        TextColor3 = Library.Scheme.DarkText,
        ZIndex = 2,
        Parent = RowObj.Frame,
    })
    New("UICorner", { CornerRadius = UDim.new(0, 2), Parent = Chip })
    local CStroke = New("UIStroke", { Thickness = 1, Parent = Chip })
    S(CStroke, "Color", "Border")
    New("UIPadding", {
        PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4),
        Parent = Chip,
    })
    AttachTooltip(Chip, function()
        return "left click: rebind  |  right click: " .. Object.Mode
    end)

    -- right-side addons must clear the obsidian switch (32px + gap) on
    -- toggle rows; checkboxes keep the old 18px base
    local Base = 2
    if ParentObject.Type == "Toggle" then
        Base = 41
    elseif ParentObject.Type == "Checkbox" then
        Base = 18
    end
    local Margin = Base + (RowObj.ControlOffset or 0)
    RowObj.ControlOffset = (RowObj.ControlOffset or 0) + 60
    RowObj:AddControl(Chip, Margin)

    function Object:UpdateChip()
        if Library.ListeningKeybind == self then
            Chip.Text = "..."
            Chip.TextColor3 = Library.Scheme.Accent
        else
            Chip.Text = string.lower(GetShortKeyName(self.Value))
            Chip.TextColor3 = (self.State and Library.Scheme.Accent) or Library.Scheme.DarkText
        end
    end

    function Object:SetState(Value, Silent)
        self.State = Value == true
        self:UpdateChip()
        Library:UpdateKeybindFrame()
        if not Silent then
            FireElement(self, self.State)
            if type(self.Info.Callback) == "function" then
                SafeCallback(self.Info.Callback, self.State)
            end
        end
    end

    function Object:SetValue(NewValue, Silent)
        local Key, Mode = self.Value, self.Mode
        if type(NewValue) == "table" then
            Key = NewValue[1] or NewValue.Key or Key
            Mode = NewValue[2] or NewValue.Mode or Mode
        elseif type(NewValue) == "string" then
            Key = NewValue
        end
        self.Value = Key or "NONE"
        self.Mode = Mode or "Toggle"
        self:UpdateChip()
        Library:UpdateKeybindFrame()
        if not Silent then
            self.ChangedList:Fire(self.Value)
            if type(self.Info.ChangedCallback) == "function" then
                SafeCallback(self.Info.ChangedCallback, self.Value)
            end
        end
    end

    function Object:GetState()
        return self.State
    end

    function Object:OnClick(Func)
        self.ClickList = self.ClickList or MakeCallbackList()
        self.ClickList:Add(Func)
    end

    -- link with parent toggle
    if Object.SyncToggleState and ParentObject.SetValue then
        ParentObject.LinkedKeybind = Object
    end

    function Object:HandleInput(IO, IsDown)
        local KeyName = GetKeyName(IO.KeyCode, IO.UserInputType)
        if not KeyName or KeyName == "NONE" then
            return
        end
        if self.Value ~= KeyName then
            return
        end

        -- menu keybind toggles the window instead
        if Library.ToggleKeybind == self and CurrentWindow then
            if IsDown then
                CurrentWindow:Toggle()
            end
            return
        end

        if self.Mode == "Hold" then
            if IsDown then
                self:SetState(true)
                if self.SyncToggleState and ParentObject.SetValue then
                    ParentObject:SetValue(true)
                end
            else
                self:SetState(false)
                if self.SyncToggleState and ParentObject.SetValue then
                    ParentObject:SetValue(false)
                end
            end
        elseif self.Mode == "Toggle" and IsDown then
            self:SetState(not self.State)
            if self.SyncToggleState and ParentObject.SetValue then
                ParentObject:SetValue(self.State)
            else
                if self.ClickList then
                    self.ClickList:Fire(self.State)
                end
                if type(self.Info.Callback) == "function" then
                    SafeCallback(self.Info.Callback, self.State)
                end
            end
        elseif self.Mode == "Press" and IsDown then
            if self.ClickList then
                self.ClickList:Fire(true)
            end
            if type(self.Info.Callback) == "function" then
                SafeCallback(self.Info.Callback, true)
            end
        elseif self.Mode == "Always" and IsDown then
            self:SetState(true)
        end
    end

    GiveSignal(Chip.MouseEnter:Connect(function()
        Tween(CStroke, 0.1, { Color = Library.Scheme.Highlight })
    end))
    GiveSignal(Chip.MouseLeave:Connect(function()
        Tween(CStroke, 0.15, { Color = Library.Scheme.Border })
    end))
    GiveSignal(Chip.MouseButton1Click:Connect(function()
        if Library.ListeningKeybind == Object then
            Library.ListeningKeybind = nil
            Object:UpdateChip()
            return
        end
        Library.ListeningKeybind = Object
        Object:UpdateChip()
    end))
    GiveSignal(Chip.MouseButton2Click:Connect(function()
        -- cycle mode
        local Pos = 1
        for I, M in ipairs(ModeOrder) do
            if M == Object.Mode then
                Pos = I
                break
            end
        end
        Object.Mode = ModeOrder[(Pos % #ModeOrder) + 1]
        Object:UpdateChip()
        Library:UpdateKeybindFrame()
        if type(Object.Info.ChangedCallback) == "function" then
            SafeCallback(Object.Info.ChangedCallback, Object.Value)
        end
    end))

    table.insert(Library.Keybinds, Object)
    Object:UpdateChip()

    -- register in the keybinds HUD panel
    if Info.NoUI ~= true then
        local DisplayName = Info.Text or (ParentObject and ParentObject.Info and ParentObject.Info.Text) or Idx or "bind"
        table.insert(Library.KeybindEntries, {
            Name = DisplayName,
            GetState = function() return Object.State end,
            GetKey = function() return GetShortKeyName(Object.Value) end,
            GetWord = function()
                if Object.Mode == "Hold" then
                    return Object.State and "holding" or "off"
                elseif Object.Mode == "Always" then
                    return "enabled"
                elseif Object.Mode == "Press" then
                    return Object.State and "pressing" or "off"
                end
                return Object.State and "toggled" or "off"
            end,
        })
    end
    -- show linked toggles inside the keybinds UI too (mobile friendly)
    if Object.SyncToggleState and Library.ShowToggleFrameInKeybinds and ParentObject.Info then
        table.insert(Library.KeybindEntries, {
            Name = ParentObject.Info.Text or "feature",
            GetState = function() return ParentObject.Value end,
            GetWord = function() return ParentObject.Value and "toggled" or "off" end,
        })
    end

    Library:UpdateKeybindFrame()

    return Object
end

-- one global input router for every keybind
GiveSignal(UserInputService.InputBegan:Connect(function(IO, GameProcessed)
    if Library.Unloaded then
        return
    end
    if IO.UserInputType == Enum.UserInputType.Keyboard and IO.KeyCode == Enum.KeyCode.Escape then
        if Library.ListeningKeybind then
            local Old = Library.ListeningKeybind
            Library.ListeningKeybind = nil
            Old:UpdateChip()
            return
        end
    end
    if Library.ListeningKeybind then
        if IO.UserInputType == Enum.UserInputType.Keyboard
        or IO.UserInputType == Enum.UserInputType.MouseButton1
        or IO.UserInputType == Enum.UserInputType.MouseButton2
        or IO.UserInputType == Enum.UserInputType.MouseButton3 then
            local KeyName = GetKeyName(IO.KeyCode, IO.UserInputType)
            if KeyName and KeyName ~= "NONE" then
                local Old = Library.ListeningKeybind
                Library.ListeningKeybind = nil
                Old:SetValue({ KeyName, Old.Mode })
                return
            end
        end
        return
    end
    if GameProcessed then
        return
    end
    for _, Keybind in ipairs(Library.Keybinds) do
        Keybind:HandleInput(IO, true)
    end
end))

GiveSignal(UserInputService.InputEnded:Connect(function(IO)
    if Library.Unloaded then
        return
    end
    for _, Keybind in ipairs(Library.Keybinds) do
        Keybind:HandleInput(IO, false)
    end
end))

