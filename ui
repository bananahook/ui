    function Window:Toggle()
        if Frame.Visible then
            Tween(WindowScale, 0.09, { Scale = 0.97 }, Enum.EasingStyle.Quad)
            task.delay(0.09, function()
                if WindowScale.Scale < 1 then
                    Frame.Visible = false
                end
                WindowScale.Scale = 1
            end)
        else
            Frame.Visible = true
            WindowScale.Scale = 0.97
            Tween(WindowScale, 0.14, { Scale = 1 }, Enum.EasingStyle.Exponential)
        end
