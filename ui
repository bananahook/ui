local BananaAsset      -- nil = unresolved, false = unavailable, string = url
local function GetBananaAsset()
    if BananaAsset ~= nil then
        return BananaAsset
    end
    BananaAsset = false
    pcall(function()
        if type(writefile) ~= "function" then
            return
        end
        local GetAsset = getcustomasset
        if type(GetAsset) ~= "function" and type(syn) == "table" and type(syn.getcustomasset) == "function" then
            GetAsset = syn.getcustomasset
        end
        if type(GetAsset) ~= "function" and type(getsynasset) == "function" then
            GetAsset = getsynasset
        end
        if type(GetAsset) ~= "function" then
            return
        end
        local Name = "bananahook_icon.png"
        local Exists = false
        if type(isfile) == "function" then
            Exists = isfile(Name) == true
        else
            Exists = select(1, pcall(function()
                return readfile(Name) ~= nil and #readfile(Name) > 0
            end))
        end
        if not Exists then
            writefile(Name, Base64Decode(BananaPNG))
        end
        BananaAsset = GetAsset(Name)
    end)
    return BananaAsset
end

-- banana vector fallback: pill segments laid along a true circular arc
-- (center 17.2, 2.2, radius 13.5, sweep 168deg in a 24-unit box), each rotated
-- to the arc tangent, with tapered widths/lengths and a gray stem. pure frames.
-- FixedColor pins the body to one color (notification icons); otherwise it
-- follows the accent.
local BananaSegments = {
    { 4.00, 5.01, -12, 5.2, 4.4 }, { 4.33, 6.28, -18, 5.3, 4.5 },
    { 4.79, 7.52, -23, 5.5, 4.7 }, { 5.37, 8.70, -29, 5.8, 5.1 },
    { 6.06, 9.83, -34, 6.2, 5.4 }, { 6.86, 10.88, -40, 6.4, 5.6 },
    { 7.75, 11.85, -46, 6.5, 5.7 }, { 8.74, 12.72, -51, 6.4, 5.6 },
    { 9.81, 13.50, -57, 6.0, 5.2 }, { 10.95, 14.16, -62, 5.4, 4.7 },
    { 12.14, 14.72, -68, 4.7, 4.1 }, { 13.39, 15.15, -74, 4.0, 3.5 },
    { 14.67, 15.46, -79, 3.3, 2.9 }, { 15.98, 15.64, -85, 2.7, 2.4 },
    { 17.29, 15.70, -90, 2.3, 2.0 }, { 18.61, 15.63, -96, 2.2, 1.9 },
}

local function MakeBanana(SizePX, FixedColor)
    -- primary path: the embedded png as a custom asset
    local Asset = GetBananaAsset()
    if Asset then
        local Img = New("ImageLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(SizePX, SizePX),
            Image = Asset,
            ScaleType = Enum.ScaleType.Fit,
        })
        if FixedColor then
            Img.ImageColor3 = FixedColor
        end
        return Img
    end
    -- fallback: pure-frame vector banana
    local Holder = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(SizePX, SizePX),
    })
    local K = SizePX / 24
    for _, Seg in ipairs(BananaSegments) do
        local Pill = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(Seg[1] / 24, Seg[2] / 24),
            Size = UDim2.fromOffset(Seg[5] * K + 0.5, Seg[4] * K + 0.5),
            Rotation = Seg[3],
            BorderSizePixel = 0,
            Parent = Holder,
        })
        New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Pill })
        if FixedColor then
            Pill.BackgroundColor3 = FixedColor
        else
            S(Pill, "BackgroundColor3", "Accent")
        end
    end
    local Stem = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(3.46 / 24, 2.42 / 24),
        Size = UDim2.fromOffset(2.0 * K + 0.5, 4.2 * K + 0.5),
        Rotation = -15,
        BorderSizePixel = 0,
        Parent = Holder,
    })
    New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Stem })
    if FixedColor then
        Stem.BackgroundColor3 = FixedColor
    else
        S(Stem, "BackgroundColor3", "InactiveText")
    end
    return Holder
end

