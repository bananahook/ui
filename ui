local Root, Wrapper, Scale, PopupOverlay, TooltipGui, TooltipLabel

local function GiveSignal(Connection)
    table.insert(Library.Signals, Connection)
    return Connection
end

function Library:InitRoot()
    if Library.Root then
        return
    end
    Root = New("ScreenGui", {
        Name = "Obsidian_" .. tostring(math.floor(tick() * 1000) % 100000),
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 1000,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    local OK = pcall(function()
        Root.Parent = CoreGui
    end)
    if not OK then
        Root.Parent = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
    end
    if not Root.Parent then
        Root.Parent = game
    end
    Library.Root = Root

    Wrapper = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Parent = Root,
    })
    Library.Wrapper = Wrapper
    Scale = New("UIScale", { Scale = 1, Parent = Wrapper })
    Library.Scale = Scale

    PopupOverlay = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Visible = false,
        ZIndex = 50,
        Parent = Wrapper,
    })
    Library.PopupOverlay = PopupOverlay
    GiveSignal(PopupOverlay.InputBegan:Connect(function(IO)
        if IO.UserInputType == Enum.UserInputType.MouseButton1 then
            for _, Child in ipairs(PopupOverlay:GetChildren()) do
                if Child:IsA("GuiObject") then
                    local P = Child.AbsolutePosition
                    local Sz = Child.AbsoluteSize
                    if IO.Position.X >= P.X and IO.Position.X <= P.X + Sz.X
                    and IO.Position.Y >= P.Y and IO.Position.Y <= P.Y + Sz.Y then
                        return
                    end
                end
            end
            Library:ClosePopup()
        end
    end))

    -- tooltip surface (own gui so it is always on top)
    TooltipGui = New("ScreenGui", {
        Name = "Obsidian_Tooltips",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 1001,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    pcall(function() TooltipGui.Parent = CoreGui end)
    if not TooltipGui.Parent then
        TooltipGui.Parent = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
    end
    TooltipLabel = New("TextLabel", {
        BackgroundColor3 = Color3.fromRGB(6, 6, 6),
        BackgroundTransparency = 0.05,
        Size = UDim2.fromOffset(0, 0),
        AutomaticSize = Enum.AutomaticSize.XY,
        Font = F.Small,
        TextSize = 12,
        TextColor3 = Library.Scheme.ActiveText,
        Text = "",
        Visible = false,
        ZIndex = 2,
        Parent = TooltipGui,
    })
    New("UICorner", { CornerRadius = UDim.new(0, 4), Parent = TooltipLabel })
    local TStroke = New("UIStroke", { Thickness = 1, Parent = TooltipLabel })
    S(TStroke, "Color", "Border")
    New("UIPadding", {
        PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
        PaddingLeft = UDim.new(0, 7), PaddingRight = UDim.new(0, 7),
        Parent = TooltipLabel,
    })
    Library.Tooltip = TooltipLabel
end

-- hooks fired whenever the open popup is dismissed (dropdown arrows etc.)
Library.PopupCloseHooks = {}

function Library:ClosePopup()
    if PopupOverlay then
        for _, Hook in ipairs(Library.PopupCloseHooks) do
            pcall(Hook)
        end
        Library.PopupCloseHooks = {}
        for _, Child in ipairs(PopupOverlay:GetChildren()) do
            if Child:IsA("GuiObject") then
                Child:Destroy()
            end
        end
        PopupOverlay.Visible = false
    end
end

local function OpenPopupAtRect(Popup, AbsPos, AbsSize, PreferLeft)
    Library:ClosePopup()
    local ScaleV = Scale.Scale
    local X = AbsPos.X / ScaleV
    local Y = (AbsPos.Y + AbsSize.Y) / ScaleV + 4
    local ViewW = Wrapper.AbsoluteSize.X / ScaleV
    local ViewH = Wrapper.AbsoluteSize.Y / ScaleV
    Popup.Parent = PopupOverlay
    PopupOverlay.Visible = true
    local PopW = Popup.AbsoluteSize.X
    local PopH = Popup.AbsoluteSize.Y
    if PreferLeft then
        X = (AbsPos.X + AbsSize.X) / ScaleV - PopW
    end
    if X + PopW > ViewW - 8 then
        X = ViewW - 8 - PopW
    end
    if X < 8 then
        X = 8
    end
    if Y + PopH > ViewH - 8 then
        Y = AbsPos.Y / ScaleV - PopH - 4
        if Y < 8 then
            Y = 8
        end
    end
    Popup.Position = UDim2.fromOffset(math.floor(X), math.floor(Y))
end

local function OpenPopupAt(Popup, Anchor, PreferLeft)
    OpenPopupAtRect(Popup, Anchor.AbsolutePosition, Anchor.AbsoluteSize, PreferLeft)
end

