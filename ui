    end)

    local function MakeBindRow()
        local RowFrame = New("Frame", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(0, 24),
            Size = UDim2.fromOffset(74, 18),
            Visible = false,
            ZIndex = 9,
