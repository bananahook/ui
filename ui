        S(Base, "BackgroundColor3", "MainColor")
        RegCorner(Base, 2)
        local BStroke = New("UIStroke", { Thickness = 1, Parent = Base })
        S(BStroke, "Color", "OutlineColor")

        local Content = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(0, 16),
            AutomaticSize = Enum.AutomaticSize.X,
            BackgroundTransparency = 1,
            Parent = Base,
        })
        New("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            HorizontalAlignment = Enum.HorizontalAlignment.Center,
            VerticalAlignment = Enum.VerticalAlignment.Center,
            Padding = UDim.new(0, 6),
            Parent = Content,
        })
        New("UIPadding", {
            PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
            Parent = Content,
        })

        local Icon
        if ButtonInfo.Icon then
            Icon = MakeTabIcon(ButtonInfo.Icon, 14)
            Icon.ZIndex = 2
            SetIconTransparency(Icon, 0.4)
            Icon.Parent = Content
        end

        local Label = New("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 0, 16, 0),
            AutomaticSize = Enum.AutomaticSize.X,
            Font = F.Row,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Center,
            Text = ButtonInfo.Text or "button",
            TextColor3 = Library.Scheme.FontColor,
            TextTransparency = 0.4,
            Parent = Content,
        })
        if ButtonInfo.Risky then
            S(Label, "TextColor3", "RedColor")
        end

        GiveSignal(Base.MouseEnter:Connect(function()
            Tween(Label, 0.1, { TextTransparency = 0 })
            if Icon then
                SetIconTransparency(Icon, 0)
            end
        end))
        GiveSignal(Base.MouseLeave:Connect(function()
            Tween(Label, 0.15, { TextTransparency = 0.4 })
            if Icon then
                SetIconTransparency(Icon, 0.4)
            end
        end))
        GiveSignal(Base.MouseButton1Click:Connect(function()
            if ButtonInfo.Disabled then
                return
            end
            if ButtonInfo.DoubleClick then
                local Now = os.clock()
                if Now - (Object.LastClick or 0) < 0.5 then
                    Object.LastClick = 0
                    SafeCallback(ButtonInfo.Func)
                else
                    Object.LastClick = Now
                end
            else
                SafeCallback(ButtonInfo.Func)
            end
        end))
        if ButtonInfo.Tooltip then
            AttachTooltip(Base, function() return ButtonInfo.Tooltip end)
        end

        table.insert(Object.Buttons, Base)
        return Base
    end

    AddButtonTo(Info)

    function Object:AddButton(SubInfo)
        AddButtonTo(type(SubInfo) == "table" and SubInfo or { Text = tostring(SubInfo) })
        return self
    end

    return Object
end
