function Library:Notify(...)
    Library:InitHUDArea()
    local Data = {}
    local Info = select(1, ...)

    if type(Info) == "table" then
        Data.Title = Info.Title ~= nil and tostring(Info.Title) or nil
        Data.TitleColor = Info.TitleColor
        Data.Description = Info.Description ~= nil and tostring(Info.Description) or nil
        Data.Time = Info.Time or 5
        Data.SoundId = Info.SoundId
        Data.Volume = tonumber(Info.Volume) or 3
        Data.Icon = Info.Icon or "!"
        Data.IconColor = Info.IconColor or Library.Scheme.Accent
    else
        Data.Description = tostring(Info)
        Data.Time = select(2, ...) or 5
        Data.SoundId = select(3, ...)
        Data.Volume = select(4, ...) or 3
        Data.Icon = "!"
        Data.IconColor = Library.Scheme.Accent
    end

    if Data.SoundId then
        pcall(function()
            local SoundService = game:GetService("SoundService")
            local Sound = Instance.new("Sound")
            Sound.SoundId = (type(Data.SoundId) == "number")
                and ("rbxassetid://" .. tostring(Data.SoundId))
                or tostring(Data.SoundId)
            Sound.Volume = Data.Volume / 10
            Sound.Parent = SoundService
            SoundService:PlayLocalSound(Sound)
            task.delay(10, function()
                Sound:Destroy()
            end)
        end)
    end

    local Area = Library.NotificationArea

    -- skeet pill: black rounded box with a colored glow, banana icon + text
    local Entry = New("Frame", {
        BackgroundColor3 = Library.Scheme.Border,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 0, 0, 20),
        AutomaticSize = Enum.AutomaticSize.X,
        Parent = Area,
    })
    New("UICorner", { CornerRadius = UDim.new(0, 5), Parent = Entry })
    local Glow = New("Frame", {
        BackgroundColor3 = Data.IconColor or Library.Scheme.Accent,
        BackgroundTransparency = 0.86,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(-3, -2),
        Size = UDim2.new(1, 6, 1, 4),
        ZIndex = 1,
        Parent = Entry,
    })
    New("UICorner", { CornerRadius = UDim.new(0, 6), Parent = Glow })
    local Inside = New("Frame", {
        BackgroundColor3 = Library.Scheme.Background,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(1, 1),
        Size = UDim2.new(1, -2, 1, -2),
        ZIndex = 2,
        Parent = Entry,
    })
    New("UICorner", { CornerRadius = UDim.new(0, 4), Parent = Inside })
    S(Inside, "BackgroundColor3", "Background")

    local Icon = MakeBanana(10, Data.IconColor or Library.Scheme.Accent)
    Icon.Position = UDim2.fromOffset(5, 4)
    Icon.ZIndex = 3
    Icon.Parent = Inside

    local TextHolder = New("Frame", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(21, 0),
        Size = UDim2.new(0, 0, 1, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        ZIndex = 3,
        Parent = Inside,
    })
    New("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 4),
        Parent = TextHolder,
    })
    New("UIPadding", { PaddingRight = UDim.new(0, 8), Parent = TextHolder })

    local FadeLabels = {}
    if Data.Title then
        local Title = New("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 0, 1, 0),
            AutomaticSize = Enum.AutomaticSize.X,
            Font = F.Row,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = Data.Title,
            TextColor3 = Data.TitleColor or Library.Scheme.White,
            ZIndex = 4,
            Parent = TextHolder,
        })
        table.insert(FadeLabels, Title)
    end
    if Data.Description then
        local Desc = New("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 0, 1, 0),
            AutomaticSize = Enum.AutomaticSize.X,
            Font = F.Small,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = Data.Description,
            TextColor3 = Library.Scheme.ActiveText,
            ZIndex = 4,
            Parent = TextHolder,
        })
        table.insert(FadeLabels, Desc)
    end

    -- cap the stack at 6
    local Count = 0
    for _, Child in ipairs(Area:GetChildren()) do
        if Child:IsA("Frame") then
            Count = Count + 1
        end
    end
    if Count > 6 then
        for _, Child in ipairs(Area:GetChildren()) do
            if Child:IsA("Frame") and Count > 6 then
                FadeOutInstance(Child, 0.25)
                task.delay(0.3, function()
                    Child:Destroy()
                end)
                Count = Count - 1
            end
        end
    end

    -- fade in
    Entry.BackgroundTransparency = 1
    Inside.BackgroundTransparency = 1
    Glow.BackgroundTransparency = 1
    for _, Label in ipairs(FadeLabels) do
        Label.TextTransparency = 1
    end
    task.defer(function()
        Tween(Entry, 0.15, { BackgroundTransparency = 0 })
        Tween(Inside, 0.15, { BackgroundTransparency = 0 })
        Tween(Glow, 0.15, { BackgroundTransparency = 0.86 })
        for _, Label in ipairs(FadeLabels) do
            Tween(Label, 0.15, { TextTransparency = 0 })
        end
    end)

    local Dismissed = false
    local function Dismiss()
        if Dismissed then
            return
        end
        Dismissed = true
        FadeOutInstance(Entry, 0.3)
        task.delay(0.35, function()
            Entry:Destroy()
        end)
    end

    if typeof and typeof(Data.Time) == "Instance" then
        task.spawn(function()
            while not Dismissed and Data.Time.Parent do
                task.wait(0.25)
            end
            Dismiss()
        end)
    else
        task.delay(tonumber(Data.Time) or 5, Dismiss)
    end

    return {
        Destroy = Dismiss,
        Instance = Entry,
    }
end

