local Root, Wrapper, Scale, PopupOverlay, TooltipGui, TooltipLabel

local function GiveSignal(Connection)
    table.insert(Library.Signals, Connection)
    return Connection
end

function Library:InitRoot()
    if Library.Root then
        return
    end
    Root = New("ScreenGui", {
        Name = "Obsidian_" .. tostring(math.floor(tick() * 1000) % 100000),
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 1000,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    local OK = pcall(function()
        Root.Parent = CoreGui
    end)
    if not OK then
        Root.Parent = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
    end
    if not Root.Parent then
        Root.Parent = game
    end
    Library.Root = Root

    Wrapper = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Parent = Root,
    })
    Library.Wrapper = Wrapper
    Scale = New("UIScale", { Scale = 1, Parent = Wrapper })
    Library.Scale = Scale

    PopupOverlay = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Visible = false,
        ZIndex = 50,
        Parent = Wrapper,
    })
    Library.PopupOverlay = PopupOverlay

    -- dismiss the open popup on any click/tap that lands outside it. this is
    -- a global input hook (like obsidian's CloseMenus), so it works with both
    -- the mouse and touch, and the tap still reaches the control below it.
    local function IsDismissInput(IO)
        return IO.UserInputState == Enum.UserInputState.Begin
            and (IO.UserInputType == Enum.UserInputType.MouseButton1
                or IO.UserInputType == Enum.UserInputType.Touch)
    end
    GiveSignal(UserInputService.InputBegan:Connect(function(IO)
        if not PopupOverlay.Visible or not IsDismissInput(IO) then
            return
        end
        local Pos = IO.Position
        for _, Child in ipairs(PopupOverlay:GetChildren()) do
            if Child:IsA("GuiObject") and Child.Visible then
                local P = Child.AbsolutePosition
                local Sz = Child.AbsoluteSize
                if Pos.X >= P.X and Pos.X <= P.X + Sz.X
                and Pos.Y >= P.Y and Pos.Y <= P.Y + Sz.Y then
                    return
                end
            end
        end
        Library:ClosePopup()
    end))

    -- tooltip surface (own gui so it is always on top)
    TooltipGui = New("ScreenGui", {
        Name = "Obsidian_Tooltips",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 1001,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    pcall(function() TooltipGui.Parent = CoreGui end)
    if not TooltipGui.Parent then
        TooltipGui.Parent = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
    end
    TooltipLabel = New("TextLabel", {
        BackgroundColor3 = Library.Scheme.BackgroundColor,
        Size = UDim2.fromOffset(0, 0),
        AutomaticSize = Enum.AutomaticSize.XY,
        Font = F.Small,
        TextSize = 14,
        TextColor3 = Library.Scheme.FontColor,
        Text = "",
        Visible = false,
        ZIndex = 2,
        Parent = TooltipGui,
    })
    New("UICorner", { CornerRadius = UDim.new(0, 2), Parent = TooltipLabel })
    local TStroke = New("UIStroke", { Thickness = 1, Parent = TooltipLabel })
    S(TStroke, "Color", "OutlineColor")
    New("UIPadding", {
        PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2),
        PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4),
        Parent = TooltipLabel,
    })
    Library.Tooltip = TooltipLabel
end

-- hooks fired whenever the open popup is dismissed (dropdown arrows etc.)
Library.PopupCloseHooks = {}

function Library:ClosePopup()
    if PopupOverlay then
        for _, Hook in ipairs(Library.PopupCloseHooks) do
            pcall(Hook)
        end
        Library.PopupCloseHooks = {}
        for _, Child in ipairs(PopupOverlay:GetChildren()) do
            if Child:IsA("GuiObject") then
                Child:Destroy()
            end
        end
        PopupOverlay.Visible = false
    end
end

local function OpenPopupAtRect(Popup, AbsPos, AbsSize, PreferLeft, Gap)
    Library:ClosePopup()
    Gap = Gap or 4
    local ScaleV = Scale.Scale
    local X = AbsPos.X / ScaleV
    local Y = (AbsPos.Y + AbsSize.Y) / ScaleV + Gap
    local ViewW = Wrapper.AbsoluteSize.X / ScaleV
    local ViewH = Wrapper.AbsoluteSize.Y / ScaleV
    Popup.Parent = PopupOverlay
    Popup.Position = UDim2.fromOffset(0, 0)
    PopupOverlay.Visible = true
    task.defer(function()
        if not Popup.Parent then
            return
        end
        local PopW = Popup.AbsoluteSize.X
        local PopH = Popup.AbsoluteSize.Y
        local PX = X
        local PY = Y
        if PreferLeft then
            PX = (AbsPos.X + AbsSize.X) / ScaleV - PopW
        end
        if PX + PopW > ViewW - 8 then
            PX = ViewW - 8 - PopW
        end
        if PX < 8 then
            PX = 8
        end
        if PY + PopH > ViewH - 8 then
            PY = AbsPos.Y / ScaleV - PopH - Gap
            if PY < 8 then
                PY = 8
            end
        end
        Popup.Position = UDim2.fromOffset(math.floor(PX), math.floor(PY))
    end)
end

local function OpenPopupAt(Popup, Anchor, PreferLeft)
    OpenPopupAtRect(Popup, Anchor.AbsolutePosition, Anchor.AbsoluteSize, PreferLeft)
end

