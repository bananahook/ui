    S(Box, "BackgroundColor3", "BackgroundColor")
    RegCorner(Box, Library.CornerRadius)
    local BoxStroke = New("UIStroke", { Thickness = 1, Parent = Box })
    S(BoxStroke, "Color", "OutlineColor")

    -- sub-tab strip
    local Strip = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 34),
        Parent = Box,
    })
    New("UIPadding", {
        PaddingTop = UDim.new(0, 7), PaddingBottom = UDim.new(0, 7),
        PaddingLeft = UDim.new(0, 7), PaddingRight = UDim.new(0, 7),
        Parent = Strip,
    })
    New("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalFlex = Enum.UIFlexAlignment.Fill,
        Padding = UDim.new(0, 6),
        Parent = Strip,
    })

    -- hairline under the strip
    local StripLine = New("Frame", {
        BackgroundColor3 = Library.Scheme.OutlineColor,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 1),
        Parent = Box,
    })
    S(StripLine, "BackgroundColor3", "OutlineColor")

    local Pages = New("Frame", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(0, 0),
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = Box,
    })
    New("UIPadding", {
        PaddingTop = UDim.new(0, 7), PaddingBottom = UDim.new(0, 7),
        PaddingLeft = UDim.new(0, 7), PaddingRight = UDim.new(0, 7),
        Parent = Pages,
    })

    local Tabbox = {
        Frame = Box,
        Pages = Pages,
        Tab = Tab,
        Side = Side,
        Tabs = {},
        Rows = {},
    }

    local FirstTabContainer
    function Tabbox:AddTab(Name)
        local Page = New("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Visible = false,
            Parent = Pages,
        })
        New("UIListLayout", {
            Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = Page,
        })

        -- obsidian sub-tab: MainColor pill, outline stroke -> accent when
        -- active, 14px label dimmed through transparency
        local Button = New("TextButton", {
            BackgroundColor3 = Library.Scheme.MainColor,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 1, 0),
            Text = "",
            AutoButtonColor = false,
            Parent = Strip,
        })
        S(Button, "BackgroundColor3", "MainColor")
        RegCorner(Button, 2)
        local BStroke = New("UIStroke", { Thickness = 1, Parent = Button })
        S(BStroke, "Color", "OutlineColor")
        New("UIPadding", {
            PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
            Parent = Button,
        })
        local Label = New("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            Font = F.Row,
            TextSize = 14,
            Text = Name or "Tab",
            TextColor3 = Library.Scheme.FontColor,
            TextTransparency = 0.5,
            Parent = Button,
        })

        local Container = {
            Frame = Box,
            Page = Page,
            Button = Button,
            List = Page,
            Name = Name,
            Tab = Tab,
            Side = Side,
            Rows = {},
            Tabbox = Tabbox,
        }
        function Container:HasVisibleRows()
            for _, Row in ipairs(self.Rows) do
                if Row.Frame.Visible then
                    return true
                end
            end
            return false
        end
        function Container:Resize() end

        GiveSignal(Button.MouseButton1Click:Connect(function()
            for _, Other in ipairs(Tabbox.Tabs) do
                Other.Page.Visible = false
                Tween(Other.Label, 0.12, { TextTransparency = 0.5 })
                if Library.ColorRegistry[Other.ButtonStroke] then
                    Library.ColorRegistry[Other.ButtonStroke].Color = "OutlineColor"
                end
                Other.ButtonStroke.Color = Library.Scheme.OutlineColor
            end
            Page.Visible = true
            Tween(Label, 0.12, { TextTransparency = 0 })
            if Library.ColorRegistry[BStroke] then
                Library.ColorRegistry[BStroke].Color = "AccentColor"
            end
            BStroke.Color = Library.Scheme.AccentColor
        end))

        Container.Label = Label
        Container.ButtonStroke = BStroke

        table.insert(Tabbox.Tabs, Container)
        table.insert(Library.SearchContainers, { Container = Container, Tab = Tab })
        SetupContainer(Container)
        if not FirstTabContainer then
            FirstTabContainer = Container
            Page.Visible = true
            Tween(Label, 0.12, { TextTransparency = 0 })
            if Library.ColorRegistry[BStroke] then
                Library.ColorRegistry[BStroke].Color = "AccentColor"
            end
            BStroke.Color = Library.Scheme.AccentColor
        end
        return Container
    end

    function Tabbox:HasVisibleRows()
        for _, Container in ipairs(self.Tabs) do
            if Container:HasVisibleRows() then
                return true
            end
        end
        return false
    end

    return Tabbox
end
-- // ----------------------------------------------------------- element rows

local function CreateRow(Container, Info, Height, RightReserve)
    Info = Info or {}
    RowCounter = RowCounter + 1

    local Row = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, Height or 16),
        LayoutOrder = RowCounter,
        Parent = Container.List,
    })

    local RowObj = {
        Frame = Row,
        Container = Container,
        Tab = Container.Tab,
        Text = Info.Text or "",
        Visible = Info.Visible ~= false,
        Disabled = Info.Disabled == true,
        Risky = Info.Risky == true,
        Controls = {},
        HasGear = false,
        TallRow = (Height or 16) > 20,
        BaseReserve = RightReserve or 6,
    }

    local Title = New("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(0, (Height or 16) > 20 and 0 or 0),
        Size = (Height or 16) > 20
            and UDim2.new(1, -(RightReserve or 6), 0, 14)
            or UDim2.new(1, -(RightReserve or 6), 1, 0),
        TextYAlignment = (Height or 16) > 20
            and Enum.TextYAlignment.Top
            or Enum.TextYAlignment.Center,
        Font = F.Row,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = Info.Text or "",
        Parent = Row,
    })
    S(Title, "TextColor3", "FontColor")
    RowObj.Title = Title

    if RowObj.Risky then
        S(Title, "TextColor3", "RedColor")
    end
    if RowObj.Disabled then
        Title.TextTransparency = 0.8
    end

    if Info.Tooltip then
        AttachTooltip(Row, function()
            return RowObj.Disabled and (Info.DisabledTooltip or Info.Tooltip) or Info.Tooltip
        end)
    end

    function RowObj:SetDisabled(Value)
        self.Disabled = Value == true
        self.Title.TextTransparency = self.Disabled and 0.8 or 0
        for _, Control in ipairs(self.Controls) do
            pcall(function()
                Control.Frame.Active = not self.Disabled
            end)
        end
    end

    function RowObj:SetText(Text)
        self.Text = Text or ""
        self.Title.Text = self.Text
    end

    function RowObj:SetVisible(Value)
        self.Visible = Value ~= false
        self.Frame.Visible = self.Visible
    end

    -- register a right-anchored control; the title shrinks so long labels
    -- ellipsize instead of running under the control
    function RowObj:AddControl(Frame, RightMargin, Width)
        local Control = { Frame = Frame, RightMargin = RightMargin or 3, Width = Width or 24 }
        table.insert(self.Controls, Control)
        self:LayoutControls()
        self:FitTitle()
        return Control
    end

    function RowObj:LayoutControls()
        local GearShift = self.HasGear and 16 or 0
        for _, Control in ipairs(self.Controls) do
            Control.Frame.Position = UDim2.new(
                1, -(Control.RightMargin + GearShift), 0.5, 0
            )
        end
    end

    function RowObj:FitTitle()
        local Need = self.BaseReserve or 6
        for _, Control in ipairs(self.Controls) do
            Need = math.max(Need, Control.RightMargin + (Control.Width or 24) + 6)
        end
        if self.TallRow then
            self.Title.Size = UDim2.new(1, -Need, 0, 14)
        else
            self.Title.Size = UDim2.new(1, -Need, 1, 0)
        end
    end

    -- gear popup ("extra" options)
    function RowObj:BuildExtra(BuildFn)
        if self.HasGear then
            return
        end
        self.HasGear = true
        self:FitTitle()

        local GearButton = New("TextButton", {
            BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -1, 0.5, 0),
            Size = UDim2.fromOffset(16, 16),
            Text = "",
            ZIndex = 4,
            Parent = Row,
        })
        local Gear = MakeIcon("settings", 14)
        Gear.AnchorPoint = Vector2.new(0.5, 0.5)
        Gear.Position = UDim2.fromScale(0.5, 0.5)
        SetIconTransparency(Gear, 0.5)
        Gear.Parent = GearButton
        GiveSignal(GearButton.MouseEnter:Connect(function()
            SetIconTransparency(Gear, 0)
        end))
        GiveSignal(GearButton.MouseLeave:Connect(function()
            SetIconTransparency(Gear, 0.5)
        end))

        GiveSignal(GearButton.MouseButton1Click:Connect(function()
            Library:ClosePopup()
            local Popup = New("Frame", {
                BackgroundColor3 = Library.Scheme.Background,
                BorderSizePixel = 0,
                Size = UDim2.fromOffset(216, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                ZIndex = 51,
            })
            New("UICorner", { CornerRadius = UDim.new(0, Library.CornerRadius), Parent = Popup })
            local PStroke = New("UIStroke", { Thickness = 1, Parent = Popup })
            S(PStroke, "Color", "OutlineColor")
            local PBody = New("Frame", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                Parent = Popup,
            })
            New("UIPadding", {
                PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
                PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
                Parent = PBody,
            })
            New("UIListLayout", {
                Padding = UDim.new(0, 3),
                SortOrder = Enum.SortOrder.LayoutOrder,
                Parent = PBody,
            })
            local PopupContainer = {
                Frame = Popup,
                List = PBody,
                Tab = self.Tab,
                Rows = {},
                IsPopup = true,
            }
            function PopupContainer:HasVisibleRows() return true end
            function PopupContainer:Resize() end
            SetupContainer(PopupContainer)
            SafeCallback(BuildFn, PopupContainer)
            OpenPopupAt(Popup, GearButton, true)
        end))

        self:LayoutControls()
    end

    table.insert(Container.Rows, RowObj)
    if Info.Text and Info.Text ~= "" then
        table.insert(Library.SearchRows, { Row = RowObj, Tab = Container.Tab })
    end

    Row.Visible = RowObj.Visible
    return RowObj
end

-- // ------------------------------------------------------------ searching

function Library:UpdateSearch(Text)
    if not CurrentWindow then
        return
    end
    Text = string.lower(Text or "")
    local Tab = CurrentWindow.ActiveTab

    for I = #Library.SearchRows, 1, -1 do
        local Entry = Library.SearchRows[I]
        if Entry.Row.Frame.Parent == nil then
            table.remove(Library.SearchRows, I)
        elseif Text == "" then
            Entry.Row.Frame.Visible = Entry.Row.Visible
        elseif Entry.Tab == Tab then
            local Match = string.find(string.lower(Entry.Row.Text or ""), Text, 1, true)
            Entry.Row.Frame.Visible = Entry.Row.Visible and Match ~= nil
        end
    end

    for I = #Library.SearchContainers, 1, -1 do
        local Entry = Library.SearchContainers[I]
        if Entry.Container.Frame.Parent == nil then
            table.remove(Library.SearchContainers, I)
        elseif Text == "" or Entry.Tab == Tab then
            if not Entry.Container.IsPopup then
                Entry.Container.Frame.Visible = Entry.Container:HasVisibleRows()
            end
        end
    end
end

-- // --------------------------------------------------------------- elements

local AttachColorPicker, AttachKeyPicker    -- fwd (defined with pickers below)

local function NormalizeArgs(Idx, Info)
    if type(Idx) == "table" then
        return nil, Idx
    end
    return Idx, Info
end

local function RegisterElement(Idx, Object, BooleanState)
    if type(Idx) ~= "string" or Idx == "" then
        return
    end
    if Library.Elements[Idx] then
        warn("[Obsidian] duplicate element index: " .. tostring(Idx))
    end
    Library.Elements[Idx] = Object
    if BooleanState then
        Library.Toggles[Idx] = Object
    else
        Library.Options[Idx] = Object
    end
end

local function MakeElementObject(RowObj, Idx, BooleanState)
    local Object = {
        Row = RowObj,
        Idx = Idx,
        ChangedList = MakeCallbackList(),
    }
    Object.ValueType = BooleanState and "Toggle" or "Option"

    function Object:OnChanged(Func)
        self.ChangedList:Add(Func)
        return self
    end

    function Object:SetDisabled(Value)
        RowObj:SetDisabled(Value)
    end

    function Object:SetVisible(Value)
        RowObj:SetVisible(Value)
    end

    function Object:SetText(Text)
        RowObj:SetText(Text)
    end

    -- fork extension: gear popup with extra options
    function Object:AddExtra(BuildFn)
        RowObj:BuildExtra(BuildFn)
        return self
    end

    RegisterElement(Idx, Object, BooleanState)
    return Object
end

local function FireElement(Object, Value)
    Object.ChangedList:Fire(Value)
    if type(Object.Info.Callback) == "function" then
        SafeCallback(Object.Info.Callback, Value)
    end
end

-- // ------------------------------------------------------- bool (toggle/checkbox)

local function CreateBoolElement(Container, Idx, Info, AsCheckbox)
    Idx, Info = NormalizeArgs(Idx, Info)
    Info = Info or {}

    local UseCheckbox = AsCheckbox or Library.ForceCheckbox
    -- obsidian geometry: both variants are 18px rows
    local RowObj = CreateRow(Container, Info, 18, UseCheckbox and 26 or 38)

    local Object = MakeElementObject(RowObj, Idx, true)
    Object.Type = UseCheckbox and "Checkbox" or "Toggle"
    Object.Info = Info
    Object.Value = Info.Default == true

    local ClickCatcher = New("TextButton", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Text = "",
        ZIndex = 3,
        Parent = RowObj.Frame,
    })

    local Visual = {}

    if UseCheckbox then
        -- obsidian checkbox: 18x18 MainColor box on the left, the lucide
        -- check fades in when checked; label sits 26px in
        local Box = New("Frame", {
            Size = UDim2.fromOffset(18, 18),
            BackgroundColor3 = Library.Scheme.MainColor,
            BorderSizePixel = 0,
            ZIndex = 2,
            Parent = RowObj.Frame,
        })
        RegCorner(Box, 2)
        local BoxStroke = New("UIStroke", { Thickness = 1, Parent = Box })
        S(BoxStroke, "Color", "OutlineColor")
        local Check = MakeCheck(14)
        Check.Position = UDim2.fromOffset(2, 2)
        Check.ZIndex = 3
        SetIconTransparency(Check, 1)
        Check.Parent = Box
        RowObj.Title.Position = UDim2.fromOffset(26, 0)
        RowObj.Title.Size = UDim2.new(1, -32, 1, 0)
        Visual.Box, Visual.Stroke, Visual.Check = Box, BoxStroke, Check
    else
        -- obsidian switch: 32x18 pill flush against the right edge,
        -- MainColor/off -> accent/on, white 14px ball, stroke follows state
        local Switch = New("Frame", {
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.fromScale(1, 0),
            Size = UDim2.fromOffset(32, 18),
            BackgroundColor3 = Library.Scheme.MainColor,
            BorderSizePixel = 0,
            ZIndex = 2,
            Parent = RowObj.Frame,
        })
        New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Switch })
        New("UIPadding", {
            PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2),
            PaddingLeft = UDim.new(0, 2), PaddingRight = UDim.new(0, 2),
            Parent = Switch,
        })
        local SwitchStroke = New("UIStroke", { Thickness = 1, Parent = Switch })
        local Ball = New("Frame", {
            AnchorPoint = Vector2.new(0, 0),
            Position = UDim2.fromScale(0, 0),
            Size = UDim2.fromScale(1, 1),
            SizeConstraint = Enum.SizeConstraint.RelativeYY,
            BackgroundColor3 = Library.Scheme.FontColor,
            BorderSizePixel = 0,
            ZIndex = 3,
            Parent = Switch,
        })
        New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Ball })
        Visual.Switch, Visual.Stroke, Visual.Ball = Switch, SwitchStroke, Ball
    end

    function Object:UpdateVisual()
        if UseCheckbox then
            SetIconTransparency(Visual.Check, self.Value and 0 or 1)
            Tween(RowObj.Title, 0.12, { TextTransparency = self.Value and 0 or 0.4 })
        else
            local Offset = self.Value and 1 or 0
            Visual.Switch.BackgroundColor3 = self.Value
                and Library.Scheme.AccentColor or Library.Scheme.MainColor
            Visual.Stroke.Color = self.Value
                and Library.Scheme.AccentColor or Library.Scheme.OutlineColor
            Tween(Visual.Ball, 0.12, {
                AnchorPoint = Vector2.new(Offset, 0),
                Position = UDim2.fromScale(Offset, 0),
            })
            Tween(RowObj.Title, 0.12, { TextTransparency = self.Value and 0 or 0.4 })
        end
    end

    function Object:SetValue(Value, Silent)
        Value = Value == true
        if self.Value == Value then
            return
        end
        self.Value = Value
        self:UpdateVisual()
        if self.LinkedKeybind and self.LinkedKeybind.SyncToggleState then
            self.LinkedKeybind:SetState(Value, true)
        end
        if not Silent then
            FireElement(self, Value)
        end
    end

    function Object:OnClicked(Func)
        self.ClickList = self.ClickList or MakeCallbackList()
        self.ClickList:Add(Func)
    end

    table.insert(Library.StateUpdaters, function()
        pcall(function() Object:UpdateVisual() end)
    end)

    Object:UpdateVisual()

    GiveSignal(ClickCatcher.MouseButton1Click:Connect(function()
        if not RowObj.Disabled then
            Object:SetValue(not Object.Value)
            if Object.ClickList then
                Object.ClickList:Fire(Object.Value)
            end
        end
    end))

    -- chainable attachments (return the toggle, like upstream)
    function Object:AddColorPicker(CPIdx, CPInfo)
        AttachColorPicker(self, RowObj, CPIdx, CPInfo)
        return self
    end

    function Object:AddKeyPicker(KPIdx, KPInfo)
        AttachKeyPicker(self, RowObj, KPIdx, KPInfo)
        return self
    end

    return Object
end
