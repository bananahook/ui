        end
        return false
    end

    function Container:Resize()
        -- AutomaticSize handles it; kept for API parity
    end

    table.insert(Library.SearchContainers, { Container = Container, Tab = Tab })
    SetupContainer(Container)
    return Container
end

-- tabbox: obsidian's boxed sub-tab strip -- a 34px row of MainColor sub-tab
-- buttons (accent stroke when active) above the shared body
local function CreateTabbox(Tab, Side)
    Side = (Side == "Right") and "Right" or "Left"
    local Column = Tab.Columns[Side]

    local Box = New("Frame", {
        BackgroundColor3 = Library.Scheme.BackgroundColor,
