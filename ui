local function CreateInput(Container, Idx, Info)
    Idx, Info = NormalizeArgs(Idx, Info)
    Info = Info or {}

    local RowObj = CreateRow(Container, Info, 44, 6)
    local Object = MakeElementObject(RowObj, Idx, false)
    Object.Type = "Input"
    Object.Info = Info
    Object.Value = Info.Default or ""

    local Box = New("TextBox", {
        BackgroundColor3 = Library.Scheme.Background,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 0, 16),
        Size = UDim2.new(1, 0, 0, 16),
        Font = F.Row,
        TextSize = 12,
        Text = tostring(Info.Default or ""),
        PlaceholderText = Info.Placeholder or "",
        PlaceholderColor3 = Library.Scheme.InactiveText,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = Library.Scheme.DarkText,
        ClearTextOnFocus = Info.ClearTextOnFocus ~= false,
        Parent = RowObj.Frame,
    })
    New("UICorner", { CornerRadius = UDim.new(0, 3), Parent = Box })
    local BStroke = New("UIStroke", { Thickness = 1, Parent = Box })
    S(BStroke, "Color", "Border")
    New("UIPadding", { PaddingLeft = UDim.new(0, 4), Parent = Box })

    if Info.MaxLength then
        Box.MaxLength = Info.MaxLength
    end

    local function Commit(Text)
        if Info.Numeric then
            Text = Text:gsub("[^%d%.%-]", "")
        end
        Object.Value = Text
        FireElement(Object, Text)
    end

    GiveSignal(Box:GetPropertyChangedSignal("Text"):Connect(function()
        if Info.Numeric then
            local Clean = Box.Text:gsub("[^%d%.%-]", "")
            if Clean ~= Box.Text then
                Box.Text = Clean
                return
            end
        end
        if Info.Finished ~= true then
            Object.Value = Box.Text
            FireElement(Object, Box.Text)
        end
    end))
    GiveSignal(Box.FocusLost:Connect(function(EnterPressed)
        if EnterPressed or Info.Finished ~= true then
            Commit(Box.Text)
        end
    end))

    function Object:SetValue(Text, Silent)
        Text = tostring(Text or "")
        self.Value = Text
        Box.Text = Text
        if not Silent then
            FireElement(self, Text)
        end
    end

    return Object
end

-- // ---------------------------------------------------------------- dropdown

local function CreateDropdown(Container, Idx, Info)
    Idx, Info = NormalizeArgs(Idx, Info)
    Info = Info or {}

    local RowObj = CreateRow(Container, Info, 39, 6)
    local Object = MakeElementObject(RowObj, Idx, false)
    Object.Type = "Dropdown"
    Object.Info = Info
    Object.Multi = Info.Multi == true
    Object.Searchable = Info.Searchable == true
    Object.SpecialType = Info.SpecialType
    Object.MaxVisible = tonumber(Info.MaxVisibleDropdownItems) or 8

    -- normalized values: array of {Key, Label}
    local Options = {}

    local function IsDict(T)
        local Count = 0
        for _ in pairs(T) do
            Count = Count + 1
        end
        local N = 0
        for I in ipairs(T) do
            N = I
        end
        return not (Count == N and Count > 0) and Count > 0
    end

    function Object:RebuildValues(KeepSelection)
        local Selected = {}
        if KeepSelection then
            if self.Multi then
                for K in pairs(self.Value) do
                    Selected[K] = true
                end
            elseif self.Value ~= nil then
                Selected[self.Value] = true
            end
        end
        Options = {}
        local Values = Info.Values
        if self.SpecialType == "Player" then
            for _, P in ipairs(Players:GetPlayers()) do
                if not (Info.ExcludeLocalPlayer and P == LocalPlayer) then
                    table.insert(Options, { Key = P.Name, Label = P.DisplayName ~= "" and (P.DisplayName) or P.Name })
                end
            end
        elseif self.SpecialType == "Team" then
            for _, T in ipairs(Teams:GetTeams()) do
                table.insert(Options, { Key = T.Name, Label = T.Name })
            end
        elseif type(Values) == "table" and IsDict(Values) then
            for K, V in pairs(Values) do
                table.insert(Options, { Key = K, Label = V })
            end
            table.sort(Options, function(A, B) return tostring(A.Key) < tostring(B.Key) end)
        elseif type(Values) == "table" then
            for _, V in ipairs(Values) do
                if type(V) == "table" then
                    table.insert(Options, { Key = V.Key or V.Value, Label = V.Label or V.Name or tostring(V.Key or V.Value) })
                else
                    table.insert(Options, { Key = V, Label = V })
                end
            end
        end
        if self.Multi then
            local NewValue = {}
            for _, Opt in ipairs(Options) do
                if Selected[Opt.Key] then
                    NewValue[Opt.Key] = true
                end
            end
            self.Value = NewValue
        else
            local Found = false
            for _, Opt in ipairs(Options) do
                if Selected[Opt.Key] then
                    self.Value = Opt.Key
                    Found = true
                    break
                end
            end
            if not Found then
                self.Value = nil
            end
        end
    end

    Object.Value = Object.Multi and {} or nil
    Object:RebuildValues(false)

    local function GetDisabledSet()
        local Set = {}
        if type(Info.DisabledValues) == "table" then
            for _, V in ipairs(Info.DisabledValues) do
                Set[V] = true
            end
        end
        return Set
    end

    local function FindOption(Key)
        for _, Opt in ipairs(Options) do
            if Opt.Key == Key or Opt.Label == Key then
                return Opt
            end
        end
        return nil
    end

    -- obsidian dropdown box below the label: 21px display with the value on
    -- the left and an arrow on the right that flips while the list is open
    local ButtonHolder = New("TextButton", {
        BackgroundColor3 = Library.Scheme.PanelBackground,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 0, 16),
        Size = UDim2.new(1, 0, 0, 21),
        AutoButtonColor = false,
        Parent = RowObj.Frame,
    })
    New("UICorner", { CornerRadius = UDim.new(0, 3), Parent = ButtonHolder })
    S(ButtonHolder, "BackgroundColor3", "PanelBackground")
    local BStroke = New("UIStroke", { Thickness = 1, Parent = ButtonHolder })
    S(BStroke, "Color", "Border")
    New("UIPadding", {
        PaddingLeft = UDim.new(0, 8),
        PaddingRight = UDim.new(0, 8),
        Parent = ButtonHolder,
    })
    local ButtonLabel = New("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -22, 1, 0),
        Font = F.Row,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = "",
        Parent = ButtonHolder,
    })
    S(ButtonLabel, "TextColor3", "DarkText")
    local ButtonChevron = MakeChevron(9, "Down")
    ButtonChevron.AnchorPoint = Vector2.new(1, 0.5)
    ButtonChevron.Position = UDim2.new(1, 0, 0.5, 0)
    ButtonChevron.Parent = ButtonHolder

    GiveSignal(ButtonHolder.MouseEnter:Connect(function()
        Tween(BStroke, 0.1, { Color = Library.Scheme.Highlight })
    end))
    GiveSignal(ButtonHolder.MouseLeave:Connect(function()
        Tween(BStroke, 0.15, { Color = Library.Scheme.Border })
    end))

    function Object:GetDisplayText()
        if self.Multi then
            local Names = {}
            for _, Opt in ipairs(Options) do
                if self.Value[Opt.Key] then
                    table.insert(Names, tostring(Opt.Label))
                end
            end
            if #Names == 0 then
                return "none"
            end
            if #Names > 3 then
                return table.concat(Names, ", ", 1, 3) .. " +" .. (#Names - 3)
            end
            return table.concat(Names, ", ")
        else
            local Opt = self.Value and FindOption(self.Value) or nil
            if not Opt then
                return "none"
            end
            if type(Info.FormatDisplayValue) == "function" then
                local Custom = Info.FormatDisplayValue(Opt.Key)
                if type(Custom) == "string" then
                    return Custom
                end
            end
            return tostring(Opt.Label)
        end
    end

    function Object:UpdateVisual()
        ButtonLabel.Text = self:GetDisplayText()
        ButtonLabel.TextTransparency = ((self.Value == nil or (self.Multi and next(self.Value) == nil)) and 0.45) or 0
    end

    function Object:SetValue(NewValue, Silent)
        if self.Multi then
            local NewMap = {}
            if type(NewValue) == "table" then
                for K, V in pairs(NewValue) do
                    if V then
                        NewMap[K] = true
                    end
                end
            elseif type(NewValue) == "string" then
                NewMap[NewValue] = true
            end
            for K in pairs(self.Value) do
                self.Value[K] = nil
            end
            for K in pairs(NewMap) do
                self.Value[K] = true
            end
        else
            local Opt = NewValue ~= nil and FindOption(NewValue) or nil
            if NewValue ~= nil and not Opt then
                return
            end
            self.Value = Opt and Opt.Key or nil
        end
        self:UpdateVisual()
        if not Silent then
            FireElement(self, self.Value)
        end
    end

    -- initial default
    do
        local Default = Info.Default
        if Default ~= nil then
            if Object.Multi then
                if type(Default) == "table" then
                    for K, V in pairs(Default) do
                        if V then
                            Object.Value[K] = true
                        end
                    end
                else
                    local Opt = FindOption(Default)
                    if Opt then
                        Object.Value[Opt.Key] = true
                    end
                end
            else
                local Opt
                if type(Default) == "number" then
                    Opt = Options[Default]
                else
                    Opt = FindOption(Default)
                end
                if Opt then
                    Object.Value = Opt.Key
                end
            end
        end
    end

    function Object:BuildList(Popup)
        local DisabledSet = GetDisabledSet()
        local SearchBox
        local ListFrame = New("ScrollingFrame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 2,
            ScrollBarImageColor3 = Library.Scheme.ScrollBar,
            BorderSizePixel = 0,
            Parent = Popup,
        })
        New("UIListLayout", {
            Padding = UDim.new(0, 2),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = ListFrame,
        })
        local RowCount = 0
        local RowFrames = {}

        local function AddOptionRow(Opt)
            RowCount = RowCount + 1
            local IsSelected = Object.Multi and Object.Value[Opt.Key] or (Object.Value == Opt.Key)
            local IsDisabled = DisabledSet[Opt.Key] or DisabledSet[Opt.Label]

            local OptButton = New("TextButton", {
                BackgroundTransparency = 1,
                BackgroundColor3 = Library.Scheme.Highlight,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 18),
                LayoutOrder = RowCount,
                Text = "",
                AutoButtonColor = false,
                Parent = ListFrame,
            })
            New("UICorner", { CornerRadius = UDim.new(0, 3), Parent = OptButton })
            local OptLabel = New("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(8, 0),
                Size = UDim2.new(1, -28, 1, 0),
                Font = F.Row,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Text = tostring(Opt.Label),
                TextTransparency = IsDisabled and 0.55 or 0,
                TextColor3 = IsSelected and Library.Scheme.Accent or Library.Scheme.InactiveText,
                Parent = OptButton,
            })
            if IsSelected then
                local Check = MakeCheck(9, "Accent")
                Check.AnchorPoint = Vector2.new(1, 0.5)
                Check.Position = UDim2.new(1, -4, 0.5, 0)
                Check.Parent = OptButton
            end
            GiveSignal(OptButton.MouseEnter:Connect(function()
                if not IsDisabled then
                    Tween(OptButton, 0.08, { BackgroundTransparency = 0.5 })
                end
            end))
            GiveSignal(OptButton.MouseLeave:Connect(function()
                Tween(OptButton, 0.12, { BackgroundTransparency = 1 })
            end))
            GiveSignal(OptButton.MouseButton1Click:Connect(function()
                if IsDisabled then
                    return
                end
                if Object.Multi then
                    if Object.Value[Opt.Key] then
                        Object.Value[Opt.Key] = nil
                    else
                        Object.Value[Opt.Key] = true
                    end
                    Object:UpdateVisual()
                    FireElement(Object, Object.Value)
                else
                    Object.Value = Opt.Key
                    Object:UpdateVisual()
                    FireElement(Object, Object.Value)
                    Library:ClosePopup()
                end
            end))
            table.insert(RowFrames, { Frame = OptButton, Label = tostring(Opt.Label) })
        end

        for _, Opt in ipairs(Options) do
            AddOptionRow(Opt)
        end

        -- multi dropdowns get a "clear" row at the bottom, like obsidian
        if Object.Multi then
            RowCount = RowCount + 1
            local ClearButton = New("TextButton", {
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 16),
                LayoutOrder = RowCount,
                Text = "",
                AutoButtonColor = false,
                Parent = ListFrame,
            })
            local ClearLabel = New("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(8, 0),
                Size = UDim2.new(1, -8, 1, 0),
                Font = F.Row,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = "clear",
                TextColor3 = Library.Scheme.Red,
                Parent = ClearButton,
            })
            S(ClearLabel, "TextColor3", "Red")
            GiveSignal(ClearButton.MouseEnter:Connect(function()
                Tween(ClearButton, 0.08, { BackgroundTransparency = 0.5 })
            end))
            GiveSignal(ClearButton.MouseLeave:Connect(function()
                Tween(ClearButton, 0.12, { BackgroundTransparency = 1 })
            end))
            GiveSignal(ClearButton.MouseButton1Click:Connect(function()
                for K in pairs(Object.Value) do
                    Object.Value[K] = nil
                end
                Object:UpdateVisual()
                FireElement(Object, Object.Value)
            end))
        end

        local RowH = 20
        local Extra = Object.Multi and 18 or 0
        local Needed = math.min(#Options, Object.MaxVisible) * RowH + 2 + Extra
        ListFrame.Size = UDim2.new(1, 0, 0, Needed)

        if Object.Searchable then
            SearchBox = New("TextBox", {
                BackgroundColor3 = Library.Scheme.Background,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 18),
                Font = F.Small,
                TextSize = 12,
                Text = "",
                PlaceholderText = "search...",
                PlaceholderColor3 = Library.Scheme.InactiveText,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextColor3 = Library.Scheme.DarkText,
                Parent = Popup,
            })
            SearchBox.LayoutOrder = 0
            New("UICorner", { CornerRadius = UDim.new(0, 3), Parent = SearchBox })
            local SStroke = New("UIStroke", { Thickness = 1, Parent = SearchBox })
            S(SStroke, "Color", "Border")
            New("UIPadding", { PaddingLeft = UDim.new(0, 4), Parent = SearchBox })
            ListFrame.LayoutOrder = 1

            GiveSignal(SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
                local Query = string.lower(SearchBox.Text)
                local VisibleCount = 0
                for _, Entry in ipairs(RowFrames) do
                    local Match = Query == "" or string.find(string.lower(Entry.Label), Query, 1, true)
                    Entry.Frame.Visible = Match
                    if Match then
                        VisibleCount = VisibleCount + 1
                    end
                end
                ListFrame.Size = UDim2.new(1, 0, 0, math.min(VisibleCount, Object.MaxVisible) * RowH + 2 + Extra)
            end))
            task.defer(function()
                SearchBox:CaptureFocus()
            end)
        end
    end

    GiveSignal(ButtonHolder.MouseButton1Click:Connect(function()
        if RowObj.Disabled then
            return
        end
        if Object.SpecialType then
            Object:RebuildValues(true)
        end
        local AbsPos, AbsSize = ButtonHolder.AbsolutePosition, ButtonHolder.AbsoluteSize
        Library:ClosePopup()
        local Popup = New("Frame", {
            BackgroundColor3 = Library.Scheme.Background,
            BorderSizePixel = 0,
            Size = UDim2.fromOffset(math.floor(AbsSize.X / Scale.Scale), 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            ZIndex = 51,
        })
        New("UICorner", { CornerRadius = UDim.new(0, 4), Parent = Popup })
        local PStroke = New("UIStroke", { Thickness = 1, Parent = Popup })
        S(PStroke, "Color", "Border")
        New("UIPadding", {
            PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
            PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4),
            Parent = Popup,
        })
        Object:BuildList(Popup)
        OpenPopupAtRect(Popup, AbsPos, AbsSize)
        -- flip the arrow while open; reset when the popup is dismissed
        ButtonChevron.Rotation = 180
        table.insert(Library.PopupCloseHooks, function()
            ButtonChevron.Rotation = 0
        end)
    end))

    Object:UpdateVisual()
    return Object
end

-- // ---------------------------------------------------------- container api

SetupContainer = function(Container)
    function Container:AddToggle(Idx, Info)
        return CreateBoolElement(Container, Idx, Info, false)
    end

    function Container:AddCheckbox(Idx, Info)
        return CreateBoolElement(Container, Idx, Info, true)
    end

    function Container:AddButton(A, B)
        return CreateButton(Container, A, B)
    end

    function Container:AddLabel(A, B, C)
        return CreateLabel(Container, A, B, C)
    end

    function Container:AddDivider()
        return CreateDivider(Container)
    end

    function Container:AddSlider(Idx, Info)
        return CreateSlider(Container, Idx, Info)
    end

    function Container:AddInput(Idx, Info)
        return CreateInput(Container, Idx, Info)
    end

    function Container:AddDropdown(Idx, Info)
        return CreateDropdown(Container, Idx, Info)
    end

    -- standalone pickers: rendered as a label row with the swatch/chip on the right
    function Container:AddColorPicker(Idx, Info)
        Info = Info or {}
        local Text = Info.Text or Info.Title or "color"
        local Label = CreateLabel(Container, Text)
        return AttachColorPicker(Label, Label.Row, Idx, Info)
    end

    function Container:AddKeyPicker(Idx, Info)
        Info = Info or {}
        local Text = Info.Text or "bind"
        local Label = CreateLabel(Container, Text)
        return AttachKeyPicker(Label, Label.Row, Idx, Info)
    end
end

-- tabs get holder builders
Library._ExtendTab = function(Tab)
    function Tab:CreateHolder(Name, Side, Info)
        return CreateGroupbox(Tab, Name, Side, Info)
    end

    function Tab:AddGroupbox(Info)
        Info = Info or {}
        return CreateGroupbox(Tab, Info.Name or "Groupbox", Info.Side or "Left", Info)
    end

    function Tab:AddLeftGroupbox(Name, IconName)
        return CreateGroupbox(Tab, Name, "Left")
    end

    function Tab:AddRightGroupbox(Name, IconName)
        return CreateGroupbox(Tab, Name, "Right")
    end

    function Tab:AddLeftTabbox()
        return CreateTabbox(Tab, "Left")
    end

    function Tab:AddRightTabbox()
        return CreateTabbox(Tab, "Right")
    end
end

