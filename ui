    local Holder = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 6),
        LayoutOrder = RowCounter,
        Parent = Container.List,
    })

    -- obsidian divider: 2px MainColor rule with a 1px outline border
    local function MakeRule(AnchorPoint, Position, Size)
        return New("Frame", {
            AnchorPoint = AnchorPoint,
