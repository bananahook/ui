        RowObj.Title.Size = UDim2.new(1, 0, 0, 0)
        RowObj.Title.AutomaticSize = Enum.AutomaticSize.Y
        RowObj.Title.TextYAlignment = Enum.TextYAlignment.Top
        RowObj.Frame.Size = UDim2.new(1, 0, 0, 0)
        RowObj.Frame.AutomaticSize = Enum.AutomaticSize.Y
    end

    function Object:SetText(NewText)
        RowObj:SetText(NewText)
    end

    function Object:AddColorPicker(CPIdx, CPInfo)
        AttachColorPicker(self, RowObj, CPIdx, CPInfo)
        return self
    end

    function Object:AddKeyPicker(KPIdx, KPInfo)
        AttachKeyPicker(self, RowObj, KPIdx, KPInfo)
        return self
    end

    return Object
end

