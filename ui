-- obsidian's draggable "Keybinds" menu: a small (15,15,15) window with a
-- 34px header, a hairline and one 16px row per bind showing
-- "[key] name (mode)". hidden until the settings toggle opens it.

function Library:InitKeybindFrame()
    if Library.KeybindFrame then
        return
    end
    Library.KeybindEntries = Library.KeybindEntries or {}

    local Panel = New("Frame", {
        BackgroundColor3 = Library.Scheme.BackgroundColor,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 6, 0.5, 0),
        Size = UDim2.fromOffset(200, 35),
        Visible = false,
        ZIndex = 30,
        Parent = Wrapper,
    })
    S(Panel, "BackgroundColor3", "BackgroundColor")
    RegCorner(Panel, Library.CornerRadius)
    local PStroke = New("UIStroke", { Thickness = 1, Parent = Panel })
    S(PStroke, "Color", "OutlineColor")
    Library.KeybindFrame = Panel

    -- header (34px, drags the panel)
    local Header = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 34),
        ZIndex = 31,
        Parent = Panel,
    })
    MakeDraggable(Header, Panel)
    local HeaderLabel = New("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Font = F.Row,
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "Keybinds",
        TextColor3 = Library.Scheme.FontColor,
        ZIndex = 32,
        Parent = Header,
    })
    New("UIPadding", {
        PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
        Parent = HeaderLabel,
    })
    local HeaderLine = New("Frame", {
        BackgroundColor3 = Library.Scheme.OutlineColor,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(0, 34),
        Size = UDim2.new(1, 0, 0, 1),
        ZIndex = 31,
        Parent = Panel,
    })
    S(HeaderLine, "BackgroundColor3", "OutlineColor")

    local Rows = {}
    Library.KeybindRows = Rows

    Library.KeybindMenu = {
        VisibilityControl = true,   -- rows only appear while active
    }
    function Library.KeybindMenu:SetVisibilityControl(Value)
        self.VisibilityControl = Value == true
        Library:UpdateKeybindFrame()
    end

    local function MakeBindRow()
        local RowFrame = New("TextButton", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 16),
            Text = "",
            AutoButtonColor = false,
            Visible = false,
            ZIndex = 31,
            Parent = Panel,
        })
        local Label = New("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(12, 0),
            Size = UDim2.new(1, -16, 1, 0),
            Font = F.Row,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Text = "",
            TextColor3 = Library.Scheme.FontColor,
            ZIndex = 32,
            Parent = RowFrame,
        })
        return { Frame = RowFrame, Label = Label }
    end

    function Library:UpdateKeybindFrame()
        if not Library.KeybindFrame then
            return
        end
        while #Rows < #Library.KeybindEntries do
            table.insert(Rows, MakeBindRow())
        end

        local RowY = 35
        local AnyVisible = false
        for I, Entry in ipairs(Library.KeybindEntries) do
            local Row = Rows[I]
            local Active = Entry.GetState()
            local Show = not Library.KeybindMenu.VisibilityControl or Active
            if Show then
                local KeyPart = Entry.GetKey and ("[%s] "):format(Entry.GetKey()) or ""
                Row.Label.Text = string.format("%s%s (%s)",
                    KeyPart, tostring(Entry.Name), Entry.GetWord and Entry.GetWord() or "off")
                Row.Label.TextTransparency = Active and 0 or 0.5
                Row.Frame.Position = UDim2.fromOffset(0, RowY)
                Row.Frame.Visible = true
                RowY = RowY + 16
                AnyVisible = true
            else
                Row.Frame.Visible = false
            end
        end
        -- breathing room under the last row
        if AnyVisible then
            RowY = RowY + 6
        end
        Panel.Size = UDim2.fromOffset(200, RowY)
        Panel.Visible = Library.KeybindFrameVisible == true and #Library.KeybindEntries > 0
    end

    function Library:SetKeybindFrameVisible(Value)
        Library.KeybindFrameVisible = Value == true
        if Library.KeybindFrame then
            Library.KeybindFrame.Visible = Value == true
        end
    end
end
