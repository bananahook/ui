    -- obsidian's draggable "Toggle" + "Lock" buttons --------------------------
    -- small rounded chips (text bounds x 2) that float on the screen edge
    -- (default: top-left), can be dragged anywhere, toggle the window and
    -- lock window dragging -- exactly like the original library's buttons.
    if Info.ShowMobileButtons ~= false then
        local Side = (Info.MobileButtonsSide == "Right") and "Right" or "Left"

        local function MeasureText(Text, Size)
            local Ok, W, H = pcall(function()
                local Params = Instance.new("GetTextBoundsParams")
                Params.Text = Text
                Params.Font = Font.fromEnum(Enum.Font.Code)
                Params.Size = Size
                return TextService:GetTextBoundsAsync(Params)
            end)
            if Ok and type(W) == "number" and type(H) == "number" then
                return W, H
            end
            -- enum.font.code fallback: ~0.58em advance, ~1.35em height
            return #tostring(Text) * Size * 0.58, Size * 1.35
        end

        local function MakeDraggableButton(Text, OnClick)
            local W, H = MeasureText(Text, 16)
            local Button = New("TextButton", {
                BackgroundColor3 = Library.Scheme.BackgroundColor,
                BorderSizePixel = 0,
                Size = UDim2.fromOffset(math.floor(W * 2), math.floor(H * 2)),
                Font = F.Brand,
                TextSize = 16,
                Text = Text,
                TextColor3 = Library.Scheme.FontColor,
                AutoButtonColor = false,
                ZIndex = 60,
                Parent = Wrapper,
            })
            RegCorner(Button, Library.CornerRadius)
            local BStroke = New("UIStroke", { Thickness = 1, Parent = Button })
            S(BStroke, "Color", "OutlineColor")
            S(Button, "BackgroundColor3", "BackgroundColor")

            -- drag it around; a click only counts if the button barely moved
            local PressPos
            MakeDraggable(Button, Button)
            GiveSignal(Button.InputBegan:Connect(function(IO)
                if IO.UserInputType == Enum.UserInputType.MouseButton1
                or IO.UserInputType == Enum.UserInputType.Touch then
                    PressPos = Button.Position
                end
            end))
            GiveSignal(Button.MouseButton1Click:Connect(function()
                if PressPos and (Button.Position.X.Offset - PressPos.X.Offset) ^ 2
                + (Button.Position.Y.Offset - PressPos.Y.Offset) ^ 2 > 100 then
                    return
                end
                SafeCallback(OnClick)
            end))

            local Handle = { Button = Button }
            function Handle:SetText(NewText)
                local NW, NH = MeasureText(NewText, 16)
                Button.Text = NewText
                Button.Size = UDim2.fromOffset(math.floor(NW * 2), math.floor(NH * 2))
            end
            return Handle
        end

        local ToggleHandle = MakeDraggableButton("Toggle", function()
            Window:Toggle()
        end)
        local LockHandle
        LockHandle = MakeDraggableButton("Lock", function()
            Library.CantDrag = not Library.CantDrag
            LockHandle:SetText(Library.CantDrag and "Unlock" or "Lock")
        end)

        local BaseX = (Side == "Left") and 6 or -6
        local BaseAnchor = (Side == "Left") and 0 or 1
        ToggleHandle.Button.AnchorPoint = Vector2.new(BaseAnchor, 0)
        ToggleHandle.Button.Position = UDim2.new(Side == "Left" and 0 or 1, BaseX, 0, 6)
        LockHandle.Button.AnchorPoint = Vector2.new(BaseAnchor, 0)
        LockHandle.Button.Position = UDim2.new(
            Side == "Left" and 0 or 1,
            BaseX + (Side == "Left" and (ToggleHandle.Button.Size.X.Offset + 12)
                or -(ToggleHandle.Button.Size.X.Offset + 12)),
            0, 6
        )
        Window.ToggleButton = ToggleHandle
        Window.LockButton = LockHandle
        Library.ToggleButton = ToggleHandle
        Library.LockButton = LockHandle
    end

    Library:InitHUDArea()
    Library:InitKeybindFrame()

    return Window
end
