local function CreateLabel(Container, A, B, C)
    local Text, DoesWrap, Idx
    if type(A) == "table" then
        Idx, Text, DoesWrap = B, A.Text or tostring(A), A.DoesWrap
    elseif type(A) == "string" and type(B) == "table" then
        Idx, Text, DoesWrap = A, B.Text or "", B.DoesWrap
    else
        Text, DoesWrap, Idx = A, B, C
    end

    local Info = { Text = Text or "" }
    local RowObj = CreateRow(Container, Info, 14, 6)
    local Object = MakeElementObject(RowObj, Idx, false)
    Object.Type = "Label"

