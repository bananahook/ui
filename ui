local IconSheetAsset      -- nil = unresolved, false = unavailable, string = url
local function GetIconSheetAsset()
    if IconSheetAsset ~= nil then
        return IconSheetAsset
    end
    IconSheetAsset = false
    pcall(function()
        if type(writefile) ~= "function" then
            return
        end
        local GetAsset = getcustomasset
        if type(GetAsset) ~= "function" and type(syn) == "table" and type(syn.getcustomasset) == "function" then
            GetAsset = syn.getcustomasset
        end
        if type(GetAsset) ~= "function" and type(getsynasset) == "function" then
            GetAsset = getsynasset
        end
        if type(GetAsset) ~= "function" then
            return
        end
        local Name = "bananahook_icons.png"
        local Exists = false
        if type(isfile) == "function" then
            Exists = isfile(Name) == true
        else
            Exists = select(1, pcall(function()
                return readfile(Name) ~= nil and #readfile(Name) > 0
            end))
        end
        if not Exists then
            writefile(Name, Base64Decode(IconSheetB64))
        end
        IconSheetAsset = GetAsset(Name)
    end)
    return IconSheetAsset
end

-- vector fallbacks for the shapes the ui cannot live without (no executor
-- filesystem / studio). plain white so callers can tint them.
local function VectorChevron(SizePX, Direction)
    local Holder = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(SizePX, SizePX),
    })
    local BaseRot = (Direction == "Down" and 45) or (Direction == "Right" and 135) or 225
    for I = 0, 1 do
        local Bar = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, I == 0 and -2 or 2, 0.5, 0),
            Size = UDim2.fromOffset(2, math.floor(SizePX * 0.66)),
            Rotation = BaseRot + (I == 0 and -45 or 45),
            BorderSizePixel = 0,
            BackgroundColor3 = Color3.new(1, 1, 1),
            Parent = Holder,
        })
    end
    return Holder
end

local function VectorCheck(SizePX)
    local Holder = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(SizePX, SizePX),
    })
    local Short = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.32, 0, 0.62, 0),
        Size = UDim2.fromOffset(2, math.max(4, SizePX * 0.34)),
        Rotation = 45,
        BorderSizePixel = 0,
        BackgroundColor3 = Color3.new(1, 1, 1),
        Parent = Holder,
    })
    local Long = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.60, 0, 0.42, 0),
        Size = UDim2.fromOffset(2, math.max(6, SizePX * 0.64)),
        Rotation = -45,
        BorderSizePixel = 0,
        BackgroundColor3 = Color3.new(1, 1, 1),
        Parent = Holder,
    })
    return Holder
end

-- main factory: returns a ready-to-parent icon holder. ImageLabel when the
-- sprite sheet is available, a vector/frame fallback otherwise.
local function MakeIcon(Name, SizePX)
    Name = string.lower(tostring(Name or ""))
    local Cell = ICON_CELLS[Name]
    if Cell then
        local Asset = GetIconSheetAsset()
        if Asset then
            return New("ImageLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.fromOffset(SizePX, SizePX),
                Image = Asset,
                ImageRectOffset = Vector2.new(Cell[1] * ICON_CELL, Cell[2] * ICON_CELL),
                ImageRectSize = Vector2.new(ICON_CELL, ICON_CELL),
                ScaleType = Enum.ScaleType.Stretch,
                ImageColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
            })
        end
    end
    if Name == "chevron-up" or Name == "chevron" then
        return VectorChevron(SizePX, "Up")
    elseif Name == "check" then
        return VectorCheck(SizePX)
    end
    return New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(SizePX, SizePX),
    })
end

-- icon helpers that work for both sprite ImageLabels and vector frames
local function SetIconTransparency(Icon, Transparency)
    if not Icon then
        return
    end
    if Icon:IsA("ImageLabel") then
        Icon.ImageTransparency = Transparency
    else
        for _, Seg in ipairs(Icon:GetDescendants()) do
            if Seg:IsA("Frame") then
                Seg.BackgroundTransparency = Transparency
            elseif Seg:IsA("UIStroke") then
                Seg.Transparency = Transparency
            end
        end
    end
end

local function SetIconColor(Icon, Color)
    if not Icon then
        return
    end
    if Icon:IsA("ImageLabel") then
        Icon.ImageColor3 = Color
    else
        for _, Seg in ipairs(Icon:GetDescendants()) do
            if Seg:IsA("Frame") then
                Seg.BackgroundColor3 = Color
            elseif Seg:IsA("UIStroke") then
                Seg.Color = Color
            end
        end
    end
end

-- compat wrappers used around the library ---------------------------------

local function MakeChevron(SizePX, Direction)
    local Icon = MakeIcon("chevron-up", SizePX)
    Icon.Rotation = (Direction == "Down" and 180) or (Direction == "Right" and 90) or 0
    return Icon
end

local function MakeCheck(SizePX)
    return MakeIcon("check", SizePX)
end

local function MakeSearchIcon(SizePX)
    return MakeIcon("search", SizePX)
end

-- tab / groupbox icons: lucide names, unknown names stay hidden
local function MakeTabIcon(IconName, SizePX)
    local Name = string.lower(tostring(IconName or ""))
    if Name == "sliders" then
        Name = "wrench"
    end
    if ICON_CELLS[Name] then
        return MakeIcon(Name, SizePX)
    end
    return New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(SizePX, SizePX),
    })
end
