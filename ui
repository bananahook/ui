-- // ------------------------------------------------------------------ slider

local function CreateSlider(Container, Idx, Info)
    Idx, Info = NormalizeArgs(Idx, Info)
    Info = Info or {}

    local Min = Info.Min or 0
    local Max = Info.Max or 100
    if Min > Max then
        Min, Max = Max, Min
    end
    local Rounding = Info.Rounding or 0
    local Compact = Info.Compact == true

    local RowObj = CreateRow(Container, Info, Compact and 15 or 33, 6)
    local Object = MakeElementObject(RowObj, Idx, false)
    Object.Type = "Slider"
    Object.Info = Info
    Object.Min = Min
    Object.Max = Max

    local Value = Clamp(tonumber(Info.Default) or Min, Min, Max)
    Object.Value = Value

    -- obsidian layout: 14px label on top, 15px bar underneath with the
    -- value/max centered on the bar (compact puts the label inside the bar)
    local Bar = New("TextButton", {
        BackgroundColor3 = Library.Scheme.MainColor,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.fromScale(0, 1),
        Size = UDim2.new(1, 0, 0, 15),
        Text = "",
        AutoButtonColor = false,
        Parent = RowObj.Frame,
    })
    RegCorner(Bar, 2)
    local BarStroke = New("UIStroke", { Thickness = 1, Parent = Bar })
    S(BarStroke, "Color", "OutlineColor")

    local Fill = New("Frame", {
        BackgroundColor3 = Library.Scheme.AccentColor,
        BorderSizePixel = 0,
        Size = UDim2.fromScale(0, 1),
        ZIndex = 2,
        Parent = Bar,
    })
    RegCorner(Fill, 2)
    S(Fill, "BackgroundColor3", "AccentColor")

    local DisplayLabel = New("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Font = F.Row,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Center,
        Text = "",
        TextColor3 = Library.Scheme.FontColor,
        ZIndex = 3,
        Parent = Bar,
    })
    New("UIStroke", {
        ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
        Color = Color3.new(0, 0, 0),
        Transparency = 0.4,
        Parent = DisplayLabel,
    })

    if Compact then
        RowObj.Title.Text = ""
    else
        RowObj.Title.Size = UDim2.new(1, -6, 0, 14)
        RowObj.Title.Position = UDim2.fromOffset(0, 0)
    end

    local function GetPct()
        return (Object.Value - Min) / math.max(Max - Min, 0.001)
    end

    function Object:FormatValue(V)
        if type(Info.FormatDisplayValue) == "function" then
            local Custom = Info.FormatDisplayValue(self, V)
            if type(Custom) == "string" then
                return Custom
            end
        end
        -- obsidian shows "value/max" on the bar (HideMax opts out)
        local Text = string.format("%." .. Rounding .. "f", V)
        if Info.Suffix then
            Text = Text .. tostring(Info.Suffix)
        end
        if Info.Prefix then
            Text = tostring(Info.Prefix) .. Text
        end
        if Info.HideMax ~= true then
            Text = Text .. "/" .. tostring(Info.Prefix or "")
                .. string.format("%." .. Rounding .. "f", Max)
                .. tostring(Info.Suffix or "")
        end
        return Text
    end

    function Object:UpdateVisual()
        local Pct = Clamp(GetPct(), 0, 1)
        Fill.Size = UDim2.fromScale(Pct, 1)
        if Compact then
            DisplayLabel.Text = string.format("%s: %s", RowObj.Text or "",
                self:FormatValue(self.Value))
        else
            DisplayLabel.Text = self:FormatValue(self.Value)
        end
    end

    function Object:SetValue(NewValue, Silent)
        NewValue = Clamp(Round(tonumber(NewValue) or Min, Rounding), Min, Max)
        if math.abs(NewValue - self.Value) < (0.1 ^ Rounding) / 2 then
            self:UpdateVisual()
            return
        end
        self.Value = NewValue
        self:UpdateVisual()
        if not Silent then
            FireElement(self, NewValue)
        end
    end

    table.insert(Library.StateUpdaters, function()
        pcall(function() Object:UpdateVisual() end)
    end)

    do
        local Dragging = false
        local function SetValueFromX(X)
            local Rel = (X - Bar.AbsolutePosition.X) / math.max(Bar.AbsoluteSize.X, 1)
            Rel = Clamp(Rel, 0, 1)
            Object:SetValue(Min + (Max - Min) * Rel)
        end

        GiveSignal(Bar.InputBegan:Connect(function(IO)
            if RowObj.Disabled then
                return
            end
            if IO.UserInputType == Enum.UserInputType.MouseButton1
            or IO.UserInputType == Enum.UserInputType.Touch then
                Dragging = true
                SetValueFromX(IO.Position.X)
            end
        end))
        GiveSignal(UserInputService.InputChanged:Connect(function(IO)
            if Dragging and (IO.UserInputType == Enum.UserInputType.MouseMovement
            or IO.UserInputType == Enum.UserInputType.Touch) then
                SetValueFromX(IO.Position.X)
            end
        end))
        GiveSignal(UserInputService.InputEnded:Connect(function(IO)
            if IO.UserInputType == Enum.UserInputType.MouseButton1
            or IO.UserInputType == Enum.UserInputType.Touch then
                Dragging = false
            end
        end))
    end

    Object:UpdateVisual()
    return Object
end

