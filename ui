        function Tab:Select()
            for _, Other in pairs(Window.Tabs) do
                Other.Page.Visible = false
                Tween(Other.Button, 0.12, { BackgroundTransparency = 1 })
                Tween(Other.Label, 0.12, { TextTransparency = 0.5 })
                if Other.TabIcon then
                    SetIconTransparency(Other.TabIcon, 0.5)
