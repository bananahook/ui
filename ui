-- color registry: instances tagged with a scheme key get recolored by SetScheme
Library.ColorRegistry = {}
Library.StateUpdaters = {}     -- functions re-applying scheme to stateful colors
Library.RoundCorners = {}      -- every UICorner following the window radius

local function S(Inst, Prop, Key)
    Library.ColorRegistry[Inst] = Library.ColorRegistry[Inst] or {}
    Library.ColorRegistry[Inst][Prop] = Key
    local Ok = pcall(function()
        Inst[Prop] = Library.Scheme[Key]
    end)
    if not Ok then
        Library.ColorRegistry[Inst][Prop] = nil
    end
    return Inst
end

-- rounded corner that follows the window's Corner Radius setting
local function RegCorner(Parent, Radius)
    local Corner = New("UICorner", { CornerRadius = UDim.new(0, Radius), Parent = Parent })
    table.insert(Library.RoundCorners, Corner)
    return Corner
end

function Library:SetScheme(Patch)
    for K, V in pairs(Patch or {}) do
        Library.Scheme[K] = V
    end
    -- keep the alias groups in sync so every key style stays valid
    local Scheme = Library.Scheme
    local function Sync(Keys, Value)
        for _, K in ipairs(Keys) do
            Scheme[K] = Value
        end
    end
    Sync({ "Accent", "AccentColor", "Yellow" }, Scheme.AccentColor)
    Sync({ "Background", "BackgroundColor", "Section" }, Scheme.BackgroundColor)
    Sync({ "MainColor", "PanelBackground" }, Scheme.MainColor)
    Sync({ "Border", "OutlineColor", "ScrollBar", "StrokeColor" }, Scheme.OutlineColor)
    Sync({ "White", "FontColor", "InactiveText", "DarkText", "ActiveText",
        "Text", "TextDim", "TextFaint" }, Scheme.FontColor)
    Sync({ "Red", "RedColor" }, Scheme.RedColor)
    -- derive the window shades from the background, exactly like obsidian's
    -- GetBetterColor steps (dark theme: 2 rgb units per step)
    if (Patch or {}).BackgroundColor or (Patch or {}).Background or (Patch or {}).Section then
        local B = Scheme.BackgroundColor
        local function Step(V, Add)
            return Clamp(V * 255 + Add * 2, 0, 255) / 255
        end
        Scheme.WindowColor = Color3.new(Step(B.R, -1), Step(B.G, -1), Step(B.B, -1))
        Scheme.ContentColor = Color3.new(Step(B.R, 1), Step(B.G, 1), Step(B.B, 1))
        Scheme.BottomColor = Color3.new(Step(B.R, 4), Step(B.G, 4), Step(B.B, 4))
    end
    for Inst, Props in pairs(Library.ColorRegistry) do
        if Inst.Parent then
            for Prop, Key in pairs(Props) do
                pcall(function()
                    Inst[Prop] = Library.Scheme[Key]
                end)
            end
        else
            Library.ColorRegistry[Inst] = nil
        end
    end
    for _, Updater in ipairs(Library.StateUpdaters) do
        pcall(Updater)
    end
end

