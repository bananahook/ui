-- // -------------------------------------------------------------- save manager

local SaveManager = {
    Folder = "Obsidian",
    SubFolder = nil,
    IgnoreList = {},
}
Library.SaveManager = SaveManager

local MemoryConfigs = {}

local function FSMkdirs(Path)
    pcall(function()
        local Current = ""
        for Segment in string.gmatch(Path, "[^/\\]+") do
            Current = Current .. Segment
            if not isfolder(Current) then
                makefolder(Current)
            end
            Current = Current .. "/"
        end
    end)
end

local function SaveDir()
    local Path = SaveManager.Folder
    if SaveManager.SubFolder and SaveManager.SubFolder ~= "" then
        Path = Path .. "/" .. SaveManager.SubFolder
    end
    return Path .. "/settings"
end

local function FSAvailable()
    return type(writefile) == "function" and type(readfile) == "function"
end

function SaveManager:SetLibrary() end
function SaveManager:IgnoreThemeSettings() end

function SaveManager:SetFolder(Folder)
    self.Folder = tostring(Folder or "Obsidian")
end

function SaveManager:SetSubFolder(SubFolder)
    self.SubFolder = SubFolder
end

function SaveManager:SetIgnoreIndexes(List)
    self.IgnoreList = {}
    for _, Idx in ipairs(List or {}) do
        self.IgnoreList[Idx] = true
    end
end

function SaveManager:GetConfigs()
    local Names = {}
    if type(listfiles) == "function" then
        pcall(function()
            FSMkdirs(SaveDir())
            for _, File in ipairs(listfiles(SaveDir())) do
                local Name = tostring(File):match("([^/\\]+)%.json$")
                if Name and Name ~= "_autoload" then
                    table.insert(Names, Name)
                end
            end
        end)
    end
    for Name in pairs(MemoryConfigs) do
        local Found = false
        for _, N in ipairs(Names) do
            if N == Name then
                Found = true
                break
            end
        end
        if not Found then
            table.insert(Names, Name)
        end
    end
    table.sort(Names)
    return Names
end

function SaveManager:SaveConfig(Name)
    Name = tostring(Name or "config")
    local Data = {}
    for Idx, Object in pairs(Library.Elements) do
        if not self.IgnoreList[Idx] and Object.Type then
            local T = Object.Type
            if T == "Toggle" or T == "Checkbox" then
                Data[Idx] = Object.Value == true
            elseif T == "Slider" or T == "Input" then
                Data[Idx] = Object.Value
            elseif T == "Dropdown" then
                if Object.Multi then
                    local Copy = {}
                    for K in pairs(Object.Value) do
                        Copy[K] = true
                    end
                    Data[Idx] = Copy
                else
                    Data[Idx] = Object.Value
                end
            elseif T == "Colorpicker" then
                Data[Idx] = {
                    R = Object.Value.R, G = Object.Value.G, B = Object.Value.B,
                    T = Object.Transparency or 0,
                }
            elseif T == "Keybind" then
                Data[Idx] = { Key = Object.Value, Mode = Object.Mode }
            end
        end
    end
    local JSON = HttpService:JSONEncode(Data)
    MemoryConfigs[Name] = JSON
    if FSAvailable() then
        pcall(function()
            FSMkdirs(SaveDir())
            writefile(SaveDir() .. "/" .. Name .. ".json", JSON)
        end)
    end
end

function SaveManager:LoadConfig(Name)
    Name = tostring(Name or "config")
    local JSON = nil
    if type(readfile) == "function" then
        pcall(function()
            JSON = readfile(SaveDir() .. "/" .. Name .. ".json")
        end)
    end
    if not JSON or JSON == "" then
        JSON = MemoryConfigs[Name]
    end
    if not JSON or JSON == "" then
        return false
    end

    local OK, Data = pcall(function()
        return HttpService:JSONDecode(JSON)
    end)
    if not OK or type(Data) ~= "table" then
        return false
    end

    for Idx, Value in pairs(Data) do
        local Object = Library.Elements[Idx]
        if Object and not self.IgnoreList[Idx] then
            local T = Object.Type
            if T == "Toggle" or T == "Checkbox" then
                Object:SetValue(Value == true)
            elseif T == "Slider" then
                Object:SetValue(tonumber(Value) or Object.Value)
            elseif T == "Input" then
                Object:SetValue(tostring(Value))
            elseif T == "Dropdown" then
                Object:SetValue(Value)
            elseif T == "Colorpicker" then
                if type(Value) == "table" then
                    Object:SetValueRGB(Color3.new(
                        tonumber(Value.R) or 1,
                        tonumber(Value.G) or 1,
                        tonumber(Value.B) or 1))
                    if Value.T then
                        Object:SetTransparency(tonumber(Value.T) or 0, true)
                    end
                end
            elseif T == "Keybind" then
                if type(Value) == "table" then
                    Object:SetValue({ Value.Key, Value.Mode })
                end
            end
        end
    end
    return true
end

function SaveManager:DeleteConfig(Name)
    Name = tostring(Name or "config")
    MemoryConfigs[Name] = nil
    if type(delfile) == "function" then
        pcall(function()
            delfile(SaveDir() .. "/" .. Name .. ".json")
        end)
    end
end

function SaveManager:SetAutoLoadConfig(Name)
    MemoryConfigs["_autoload"] = tostring(Name or "")
    if FSAvailable() then
        pcall(function()
            FSMkdirs(SaveDir())
            writefile(SaveDir() .. "/_autoload.json", HttpService:JSONEncode({ Name = Name }))
        end)
    end
end

function SaveManager:LoadAutoloadConfig()
    local Name = MemoryConfigs["_autoload"]
    if type(readfile) == "function" then
        pcall(function()
            local JSON = readfile(SaveDir() .. "/_autoload.json")
            local Data = HttpService:JSONDecode(JSON)
            if Data and Data.Name then
                Name = Data.Name
            end
        end)
    end
    if Name and Name ~= "" then
        return self:LoadConfig(Name)
    end
    return false
end

function SaveManager:BuildConfigSection(Tab)
    local Group = Tab:AddGroupbox({
        Name = "configuration",
        Side = "Right",
    })

    self.IgnoreList["SaveManager_Name"] = true
    self.IgnoreList["SaveManager_List"] = true
    self.IgnoreList["SaveManager_AutoLoad"] = true

    Group:AddInput("SaveManager_Name", {
        Text = "config name",
        Placeholder = "my config",
    })
    local ListDropdown = Group:AddDropdown("SaveManager_List", {
        Text = "saved configs",
        Values = self:GetConfigs(),
        Default = 1,
        Callback = function(Value)
            if Value and Value ~= "none" then
                Library.Options.SaveManager_Name:SetValue(Value, true)
            end
        end,
    })
    Group:AddButton({
        Text = "save",
        Func = function()
            local Name = Library.Options.SaveManager_Name.Value
            if Name == "" then
                Name = "config"
            end
            self:SaveConfig(Name)
            Library:Notify({ Title = "configuration", Description = "saved '" .. Name .. "'", Time = 3 })
        end,
    }):AddButton({
        Text = "load",
        Func = function()
            local Name = Library.Options.SaveManager_Name.Value
            if Name == "" then
                Name = "config"
            end
            if self:LoadConfig(Name) then
                Library:Notify({ Title = "configuration", Description = "loaded '" .. Name .. "'", Time = 3 })
            else
                Library:Notify({ Title = "configuration", Description = "config '" .. Name .. "' not found", Time = 3, IconColor = Library.Scheme.Red })
            end
        end,
    })
    Group:AddButton({
        Text = "refresh list",
        Func = function()
            ListDropdown.Info.Values = self:GetConfigs()
            ListDropdown:RebuildValues(true)
            ListDropdown:UpdateVisual()
        end,
    })
    Group:AddButton({
        Text = "delete",
        Func = function()
            local Name = Library.Options.SaveManager_Name.Value
            if Name ~= "" then
                self:DeleteConfig(Name)
                Library:Notify({ Title = "configuration", Description = "deleted '" .. Name .. "'", Time = 3 })
            end
        end,
    })
    Group:AddToggle("SaveManager_AutoLoad", {
        Text = "auto-load this config",
        Default = false,
        Callback = function(Value)
            if Value then
                local Name = Library.Options.SaveManager_Name.Value
                if Name ~= "" then
                    self:SetAutoLoadConfig(Name)
                    Library:Notify({ Title = "configuration", Description = "'" .. Name .. "' will auto-load", Time = 3 })
                end
            else
                self:SetAutoLoadConfig("")
            end
        end,
    })
    return Group
end

