-- // ----------------------------------------------------------- element rows

local function CreateRow(Container, Info, Height, RightReserve)
    Info = Info or {}
    RowCounter = RowCounter + 1

    local Row = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, Height or 16),
        LayoutOrder = RowCounter,
        Parent = Container.List,
    })

    local RowObj = {
        Frame = Row,
        Container = Container,
        Tab = Container.Tab,
        Text = Info.Text or "",
        Visible = Info.Visible ~= false,
        Disabled = Info.Disabled == true,
        Risky = Info.Risky == true,
        Controls = {},
        HasGear = false,
    }

    local Title = New("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(0, (Height or 16) > 20 and 0 or 0),
        Size = (Height or 16) > 20
            and UDim2.new(1, -(RightReserve or 6), 0, 12)
            or UDim2.new(1, -(RightReserve or 6), 1, 0),
        TextYAlignment = (Height or 16) > 20
            and Enum.TextYAlignment.Top
            or Enum.TextYAlignment.Center,
        Font = F.Row,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = Info.Text or "",
        Parent = Row,
    })
    S(Title, "TextColor3", "InactiveText")
    RowObj.Title = Title

    if RowObj.Risky then
        S(Title, "TextColor3", "Red")
    end
    if RowObj.Disabled then
        Title.TextTransparency = 0.55
    end

    if Info.Tooltip then
        AttachTooltip(Row, function()
            return RowObj.Disabled and (Info.DisabledTooltip or Info.Tooltip) or Info.Tooltip
        end)
    end

    function RowObj:SetDisabled(Value)
        self.Disabled = Value == true
        self.Title.TextTransparency = self.Disabled and 0.55 or 0
        for _, Control in ipairs(self.Controls) do
            pcall(function()
                Control.Frame.Active = not self.Disabled
            end)
        end
    end

    function RowObj:SetText(Text)
        self.Text = Text or ""
        self.Title.Text = self.Text
    end

    function RowObj:SetVisible(Value)
        self.Visible = Value ~= false
        self.Frame.Visible = self.Visible
    end

    -- register a right-anchored control so the gear can shift it left
    function RowObj:AddControl(Frame, RightMargin)
        local Control = { Frame = Frame, RightMargin = RightMargin or 3 }
        table.insert(self.Controls, Control)
        self:LayoutControls()
        return Control
    end

    function RowObj:LayoutControls()
        local GearShift = self.HasGear and 16 or 0
        for _, Control in ipairs(self.Controls) do
            Control.Frame.Position = UDim2.new(
                1, -(Control.RightMargin + GearShift), 0.5, 0
            )
        end
    end

    -- gear popup ("extra" options)
    function RowObj:BuildExtra(BuildFn)
        if self.HasGear then
            return
        end
        self.HasGear = true

        local GearButton = New("TextButton", {
            BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -1, 0.5, 0),
            Size = UDim2.fromOffset(14, 14),
            Text = "",
            ZIndex = 4,
            Parent = Row,
        })
        local Gear = MakeGear(10)
        Gear.Position = UDim2.fromOffset(2, 2)
        Gear.Parent = GearButton
        GiveSignal(GearButton.MouseEnter:Connect(function()
            for _, Tooth in ipairs(Gear:GetChildren()) do
                if Tooth:IsA("Frame") then
                    Tween(Tooth, 0.1, { BackgroundColor3 = Library.Scheme.Highlight })
                end
            end
        end))
        GiveSignal(GearButton.MouseLeave:Connect(function()
            for _, Tooth in ipairs(Gear:GetChildren()) do
                if Tooth:IsA("Frame") then
                    Tween(Tooth, 0.15, { BackgroundColor3 = Library.Scheme.DarkText })
                end
            end
        end))

        GiveSignal(GearButton.MouseButton1Click:Connect(function()
            Library:ClosePopup()
            local Popup = New("Frame", {
                BackgroundColor3 = Library.Scheme.Background,
                BorderSizePixel = 0,
                Size = UDim2.fromOffset(216, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                ZIndex = 51,
            })
            New("UICorner", { CornerRadius = UDim.new(0, 4), Parent = Popup })
            local PStroke = New("UIStroke", { Thickness = 1, Parent = Popup })
            S(PStroke, "Color", "Border")
            local PBody = New("Frame", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                Parent = Popup,
            })
            New("UIPadding", {
                PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
                PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
                Parent = PBody,
            })
            New("UIListLayout", {
                Padding = UDim.new(0, 3),
                SortOrder = Enum.SortOrder.LayoutOrder,
                Parent = PBody,
            })
            local PopupContainer = {
                Frame = Popup,
                List = PBody,
                Tab = self.Tab,
                Rows = {},
                IsPopup = true,
            }
            function PopupContainer:HasVisibleRows() return true end
            function PopupContainer:Resize() end
            SetupContainer(PopupContainer)
            SafeCallback(BuildFn, PopupContainer)
            OpenPopupAt(Popup, GearButton, true)
        end))

        self:LayoutControls()
    end

    table.insert(Container.Rows, RowObj)
    if Info.Text and Info.Text ~= "" then
        table.insert(Library.SearchRows, { Row = RowObj, Tab = Container.Tab })
    end

    Row.Visible = RowObj.Visible
    return RowObj
end

-- // ------------------------------------------------------------ searching

function Library:UpdateSearch(Text)
    if not CurrentWindow then
        return
    end
    Text = string.lower(Text or "")
    local Tab = CurrentWindow.ActiveTab

    for I = #Library.SearchRows, 1, -1 do
        local Entry = Library.SearchRows[I]
        if Entry.Row.Frame.Parent == nil then
            table.remove(Library.SearchRows, I)
        elseif Text == "" then
            Entry.Row.Frame.Visible = Entry.Row.Visible
        elseif Entry.Tab == Tab then
            local Match = string.find(string.lower(Entry.Row.Text or ""), Text, 1, true)
            Entry.Row.Frame.Visible = Entry.Row.Visible and Match ~= nil
        end
    end

    for I = #Library.SearchContainers, 1, -1 do
        local Entry = Library.SearchContainers[I]
        if Entry.Container.Frame.Parent == nil then
            table.remove(Library.SearchContainers, I)
        elseif Text == "" or Entry.Tab == Tab then
            if not Entry.Container.IsPopup then
                Entry.Container.Frame.Visible = Entry.Container:HasVisibleRows()
            end
        end
    end
end

-- // --------------------------------------------------------------- elements

local AttachColorPicker, AttachKeyPicker    -- fwd (defined with pickers below)

local function NormalizeArgs(Idx, Info)
    if type(Idx) == "table" then
        return nil, Idx
    end
    return Idx, Info
end

local function RegisterElement(Idx, Object, BooleanState)
    if type(Idx) ~= "string" or Idx == "" then
        return
    end
    if Library.Elements[Idx] then
        warn("[Obsidian] duplicate element index: " .. tostring(Idx))
    end
    Library.Elements[Idx] = Object
    if BooleanState then
        Library.Toggles[Idx] = Object
    else
        Library.Options[Idx] = Object
    end
end

local function MakeElementObject(RowObj, Idx, BooleanState)
    local Object = {
        Row = RowObj,
        Idx = Idx,
        ChangedList = MakeCallbackList(),
    }
    Object.ValueType = BooleanState and "Toggle" or "Option"

    function Object:OnChanged(Func)
        self.ChangedList:Add(Func)
        return self
    end

    function Object:SetDisabled(Value)
        RowObj:SetDisabled(Value)
    end

    function Object:SetVisible(Value)
        RowObj:SetVisible(Value)
    end

    function Object:SetText(Text)
        RowObj:SetText(Text)
    end

    -- fork extension: gear popup with extra options
    function Object:AddExtra(BuildFn)
        RowObj:BuildExtra(BuildFn)
        return self
    end

    RegisterElement(Idx, Object, BooleanState)
    return Object
end

local function FireElement(Object, Value)
    Object.ChangedList:Fire(Value)
    if type(Object.Info.Callback) == "function" then
        SafeCallback(Object.Info.Callback, Value)
    end
end

-- // ------------------------------------------------------- bool (toggle/checkbox)

local function CreateBoolElement(Container, Idx, Info, AsCheckbox)
    Idx, Info = NormalizeArgs(Idx, Info)
    Info = Info or {}

    local UseCheckbox = AsCheckbox or Library.ForceCheckbox
    -- obsidian geometry: switch rows are 18px tall (label left, 32x18 pill
    -- right); checkbox rows keep the compact 16px skeet skeleton
    local RowObj = CreateRow(Container, Info, UseCheckbox and 16 or 18, UseCheckbox and 20 or 41)

    local Object = MakeElementObject(RowObj, Idx, true)
    Object.Type = UseCheckbox and "Checkbox" or "Toggle"
    Object.Info = Info
    Object.Value = Info.Default == true

    local ClickCatcher = New("TextButton", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Text = "",
        ZIndex = 3,
        Parent = RowObj.Frame,
    })

    local Visual = {}

    if UseCheckbox then
        -- skeet checkbox on the LEFT of the label: 12x12 black box, 1px
        -- border, accent check inside; the label sits 17px in
        local Box = New("Frame", {
            Size = UDim2.fromOffset(12, 12),
            BackgroundColor3 = Library.Scheme.Background,
            BorderSizePixel = 0,
            ZIndex = 2,
            Parent = RowObj.Frame,
        })
        Box.Position = UDim2.fromOffset(0, 2)
        New("UICorner", { CornerRadius = UDim.new(0, 3), Parent = Box })
        local BoxStroke = New("UIStroke", { Thickness = 1, Parent = Box })
        S(BoxStroke, "Color", "Border")
        local Check = MakeCheck(12, "Accent")
        Check.Position = UDim2.fromOffset(1, 1)
        Check.Size = UDim2.fromOffset(10, 10)
        Check.Visible = false
        Check.ZIndex = 3
        Check.Parent = Box
        RowObj.Title.Position = UDim2.fromOffset(17, 0)
        RowObj.Title.Size = UDim2.new(1, -35, 1, 0)
        Visual.Box, Visual.Stroke, Visual.Check = Box, BoxStroke, Check

        GiveSignal(Box.MouseEnter:Connect(function()
            if not RowObj.Disabled then
                Tween(BoxStroke, 0.1, { Color = Library.Scheme.Highlight })
            end
        end))
        GiveSignal(Box.MouseLeave:Connect(function()
            Tween(BoxStroke, 0.15, { Color = Library.Scheme.Border })
        end))
    else
        -- obsidian toggle switch on the RIGHT of the label: 32x18 rounded
        -- pill with a 14px sliding ball -- accent + white when on, dark
        -- panel + border when off
        local Switch = New("Frame", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -3, 0.5, 0),
            Size = UDim2.fromOffset(32, 18),
            BackgroundColor3 = Library.Scheme.PanelBackground,
            BorderSizePixel = 0,
            ZIndex = 2,
            Parent = RowObj.Frame,
        })
        New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Switch })
        New("UIPadding", {
            PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2),
            PaddingLeft = UDim.new(0, 2), PaddingRight = UDim.new(0, 2),
            Parent = Switch,
        })
        local SwitchStroke = New("UIStroke", { Thickness = 1, Parent = Switch })
        local Ball = New("Frame", {
            AnchorPoint = Vector2.new(0, 0),
            Position = UDim2.fromScale(0, 0),
            Size = UDim2.fromScale(1, 1),
            SizeConstraint = Enum.SizeConstraint.RelativeYY,
            BackgroundColor3 = Library.Scheme.White,
            BorderSizePixel = 0,
            ZIndex = 3,
            Parent = Switch,
        })
        New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Ball })
        Visual.Switch, Visual.Stroke, Visual.Ball = Switch, SwitchStroke, Ball

        -- obsidian label behavior: white text, 40% faded while off
        if not RowObj.Risky and Library.ColorRegistry[RowObj.Title] then
            Library.ColorRegistry[RowObj.Title].TextColor3 = "White"
        end
        RowObj.Title.TextColor3 = RowObj.Risky and Library.Scheme.Red or Library.Scheme.White

        GiveSignal(Switch.MouseEnter:Connect(function()
            if not RowObj.Disabled then
                Tween(SwitchStroke, 0.1, { Color = Library.Scheme.Highlight })
            end
        end))
        GiveSignal(Switch.MouseLeave:Connect(function()
            Tween(SwitchStroke, 0.15, {
                Color = Object.Value and Library.Scheme.Accent or Library.Scheme.Border,
            })
        end))
    end

    function Object:UpdateVisual()
        if UseCheckbox then
            if self.Value then
                Visual.Check.Visible = true
                S(RowObj.Title, "TextColor3", "ActiveText")
            else
                Visual.Check.Visible = false
                S(RowObj.Title, "TextColor3", "InactiveText")
            end
        else
            if self.Value then
                Visual.Switch.BackgroundColor3 = Library.Scheme.Accent
                Visual.Stroke.Color = Library.Scheme.Accent
                Tween(Visual.Ball, 0.12, {
                    AnchorPoint = Vector2.new(1, 0),
                    Position = UDim2.fromScale(1, 0),
                })
                RowObj.Title.TextTransparency = 0
            else
                Visual.Switch.BackgroundColor3 = Library.Scheme.PanelBackground
                Visual.Stroke.Color = Library.Scheme.Border
                Tween(Visual.Ball, 0.12, {
                    AnchorPoint = Vector2.new(0, 0),
                    Position = UDim2.fromScale(0, 0),
                })
                RowObj.Title.TextTransparency = 0.4
            end
        end
    end

    function Object:SetValue(Value, Silent)
        Value = Value == true
        if self.Value == Value then
            return
        end
        self.Value = Value
        self:UpdateVisual()
        if self.LinkedKeybind and self.LinkedKeybind.SyncToggleState then
            self.LinkedKeybind:SetState(Value, true)
        end
        if not Silent then
            FireElement(self, Value)
        end
    end

    function Object:OnClicked(Func)
        self.ClickList = self.ClickList or MakeCallbackList()
        self.ClickList:Add(Func)
    end

    table.insert(Library.StateUpdaters, function()
        pcall(function() Object:UpdateVisual() end)
    end)

    Object:UpdateVisual()

    GiveSignal(ClickCatcher.MouseButton1Click:Connect(function()
        if not RowObj.Disabled then
            Object:SetValue(not Object.Value)
            if Object.ClickList then
                Object.ClickList:Fire(Object.Value)
            end
        end
    end))

    -- chainable attachments (return the toggle, like upstream)
    function Object:AddColorPicker(CPIdx, CPInfo)
        AttachColorPicker(self, RowObj, CPIdx, CPInfo)
        return self
    end

    function Object:AddKeyPicker(KPIdx, KPInfo)
        AttachKeyPicker(self, RowObj, KPIdx, KPInfo)
        return self
    end

    return Object
end

-- // ------------------------------------------------------------------ button

local function CreateButton(Container, A, B)
    local Info
    if type(A) == "table" then
        Info = A
    elseif type(A) == "string" and type(B) == "function" then
        Info = { Text = A, Func = B }
    elseif type(A) == "string" and type(B) == "table" then
        Info = B
        Info.Text = Info.Text or A
    end
    Info = Info or {}

    RowCounter = RowCounter + 1
    local Holder = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 16),
        LayoutOrder = RowCounter,
        Parent = Container.List,
    })
    New("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 4),
        Parent = Holder,
    })

    local Object = { Type = "Button", Info = Info, Buttons = {}, Row = { Frame = Holder } }

    local function AddButtonTo(ButtonInfo)
        local Button = New("TextButton", {
            BackgroundColor3 = Library.Scheme.Background,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 1, 0),
            Font = F.Row,
            TextSize = 12,
            Text = ButtonInfo.Text or "button",
            TextXAlignment = Enum.TextXAlignment.Left,
            AutoButtonColor = false,
            TextColor3 = Library.Scheme.DarkText,
            Parent = Holder,
        })
        New("UICorner", { CornerRadius = UDim.new(0, 3), Parent = Button })
        local BStroke = New("UIStroke", { Thickness = 1, Parent = Button })
        S(BStroke, "Color", "Border")
        New("UIPadding", {
            PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 14),
            Parent = Button,
        })
        local Arrow = MakeChevron(8, "Right")
        Arrow.AnchorPoint = Vector2.new(1, 0.5)
        Arrow.Position = UDim2.new(1, -3, 0.5, 0)
        Arrow.Parent = Button
        if ButtonInfo.Risky then
            S(Button, "TextColor3", "Red")
        end

        local Clicks = { Last = 0 }
        GiveSignal(Button.MouseEnter:Connect(function()
            Tween(BStroke, 0.1, { Color = Library.Scheme.Highlight })
        end))
        GiveSignal(Button.MouseLeave:Connect(function()
            Tween(BStroke, 0.15, { Color = Library.Scheme.Border })
        end))
        GiveSignal(Button.MouseButton1Click:Connect(function()
            if ButtonInfo.Disabled then
                return
            end
            -- click flash, juju style: background dips to dark gray and back
            Tween(Button, 0.075, { BackgroundColor3 = Color3.fromRGB(40, 40, 40) })
            task.delay(0.075, function()
                Tween(Button, 0.075, { BackgroundColor3 = Library.Scheme.Background })
            end)
            if ButtonInfo.DoubleClick then
                local Now = os.clock()
                if Now - Clicks.Last < 0.5 then
                    Clicks.Last = 0
                    SafeCallback(ButtonInfo.Func)
                else
                    Clicks.Last = Now
                end
            else
                SafeCallback(ButtonInfo.Func)
            end
        end))
        if ButtonInfo.Tooltip then
            AttachTooltip(Button, function() return ButtonInfo.Tooltip end)
        end

        table.insert(Object.Buttons, Button)
        local Count = #Object.Buttons
        for I, Btn in ipairs(Object.Buttons) do
            Btn.Size = UDim2.new(1 / Count, -(Count - 1) * 2, 1, 0)
            Btn.LayoutOrder = I
        end
        return Button
    end

    AddButtonTo(Info)

    function Object:AddButton(SubInfo)
        AddButtonTo(type(SubInfo) == "table" and SubInfo or { Text = tostring(SubInfo) })
        return self
    end

    return Object
end

