-- // ------------------------------------------------------------------ utils

local function New(ClassName, Props, Children)
    local Inst = Instance.new(ClassName)
    if Props then
        for K, V in pairs(Props) do
            if K ~= "Parent" then
                Inst[K] = V
            end
        end
    end
    if Children then
        for _, Child in ipairs(Children) do
            Child.Parent = Inst
        end
    end
    if Props and Props.Parent then
        Inst.Parent = Props.Parent
    end
    return Inst
end

local function Tween(Inst, Time, Props, Style, Direction)
    local Info = TweenInfo.new(Time or 0.12, Style or Enum.EasingStyle.Quad, Direction or Enum.EasingDirection.Out)
    local TweenObj = TweenService:Create(Inst, Info, Props)
    TweenObj:Play()
    return TweenObj
end

local function SafeCallback(Func, ...)
    if type(Func) ~= "function" then
        return
    end
    local Ok, Err = pcall(Func, ...)
    if not Ok then
        warn("[Obsidian] callback error:", Err)
    end
end

-- A list of callbacks that can be added to and fired async-safe.
local function MakeCallbackList()
    local List = { Callbacks = {} }
    function List:Add(Func)
        if type(Func) == "function" then
            table.insert(self.Callbacks, Func)
        end
        return Func
    end
    function List:Fire(...)
        for _, Func in ipairs(self.Callbacks) do
            task.spawn(SafeCallback, Func, ...)
        end
    end
    return List
end

local function Round(Value, Decimals)
    local Mult = 10 ^ (Decimals or 0)
    return math.floor(Value * Mult + 0.5) / Mult
end

local function Clamp(Value, Min, Max)
    if Value < Min then return Min end
    if Value > Max then return Max end
    return Value
end

local function DeepCompare(A, B)
    if type(A) ~= "table" or type(B) ~= "table" then
        return A == B
    end
    for K, V in pairs(A) do
        if not DeepCompare(V, B[K]) then return false end
    end
    for K, V in pairs(B) do
        if A[K] == nil and V ~= nil then return false end
    end
    return true
end

-- // ------------------------------------------------------------- key naming

local function GetKeyName(KeyCode, UserInputType)
    if UserInputType ~= nil and UserInputType ~= Enum.UserInputType.Keyboard then
        local Name = UserInputType.Name
        Name = Name:gsub("MouseButton", "MB")
        if Name == "MB1" or Name == "MB2" or Name == "MB3" then
            return Name
        end
        if Name == "Touch" or Name == "Keyboard" then
            return nil
        end
        return Name
    end
    if KeyCode == nil or KeyCode == Enum.KeyCode.Unknown then
        return "NONE"
    end
    return KeyCode.Name
end

local function GetKeyEnumsFromName(Name)
    if Name == nil or Name == "NONE" or Name == "" then
        return nil, nil
    end
    if Name == "MB1" then return nil, Enum.UserInputType.MouseButton1 end
    if Name == "MB2" then return nil, Enum.UserInputType.MouseButton2 end
    if Name == "MB3" then return nil, Enum.UserInputType.MouseButton3 end
    local ok, KC = pcall(function() return Enum.KeyCode[Name] end)
    if ok and KC then
        return KC, nil
    end
    return nil, nil
end

local function GetShortKeyName(Name)
    return Name or "none"
end

