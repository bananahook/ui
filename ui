-- Icons are drawn with pure frames (no external assets, always renders).

local function MakeChevron(SizePX, Direction)
    -- a "v" made of two rotated bars; Direction: "Down" | "Up" | "Right"
    local Holder = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(SizePX, SizePX),
    })
    local BaseRot = (Direction == "Up" and 45) or (Direction == "Right" and 135) or 225
    for I = 0, 1 do
        local Bar = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, I == 0 and -1.5 or 1.5, 0.5, 0),
            Size = UDim2.fromOffset(1.6, math.floor(SizePX * 0.62)),
            Rotation = BaseRot + (I == 0 and -45 or 45),
            BorderSizePixel = 0,
            Parent = Holder,
        })
        S(Bar, "BackgroundColor3", "DarkText")
    end
    return Holder
end

local function MakeCheck(SizePX, Key)
    local Holder = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(SizePX, SizePX),
    })
    local Short = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.32, 0, 0.62, 0),
        Size = UDim2.fromOffset(1.8, math.max(4, SizePX * 0.32)),
        Rotation = 45,
        BorderSizePixel = 0,
        Parent = Holder,
    })
    local Long = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.60, 0, 0.42, 0),
        Size = UDim2.fromOffset(1.8, math.max(6, SizePX * 0.62)),
        Rotation = -45,
        BorderSizePixel = 0,
        Parent = Holder,
    })
    for _, Bar in ipairs({ Short, Long }) do
        if Key then
            S(Bar, "BackgroundColor3", Key)
        else
            Bar.BackgroundColor3 = Color3.new(1, 1, 1)
        end
    end
    return Holder
end

local function MakeMagnifier(SizePX)
    local Holder = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(SizePX, SizePX),
    })
    local Lens = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.42, 0.42),
        Size = UDim2.new(1, -7, 1, -7),
        BackgroundTransparency = 1,
        Parent = Holder,
    })
    New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Lens })
    local Stroke = New("UIStroke", { Thickness = 1.5, Parent = Lens })
    S(Stroke, "Color", "DarkText")
    local Handle = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.86, 0.86),
        Size = UDim2.fromOffset(math.max(4, SizePX * 0.3), 1.5),
        Rotation = 45,
        BorderSizePixel = 0,
        Parent = Holder,
    })
    S(Handle, "BackgroundColor3", "DarkText")
    return Holder
end

local function MakeGear(SizePX)
    local Gear = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(SizePX, SizePX),
    })
    local Ring = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.new(1, -6, 1, -6),
        BackgroundTransparency = 1,
        Parent = Gear,
    })
    New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Ring })
    local Stroke = New("UIStroke", { Thickness = 1.4, Parent = Ring })
    S(Stroke, "Color", "DarkText")
    local ToothLen = math.max(3, math.floor(SizePX * 0.3))
    local Positions = {
        {X = 0.5, Y = 0.04, R = 0}, {X = 0.5, Y = 0.96, R = 0},
        {X = 0.04, Y = 0.5, R = 90}, {X = 0.96, Y = 0.5, R = 90},
        {X = 0.14, Y = 0.14, R = 45}, {X = 0.86, Y = 0.14, R = 135},
        {X = 0.14, Y = 0.86, R = 135}, {X = 0.86, Y = 0.86, R = 45},
    }
    for _, Pos in ipairs(Positions) do
        local Tooth = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(Pos.X, Pos.Y),
            Size = UDim2.fromOffset(1.8, ToothLen),
            Rotation = Pos.R,
            BorderSizePixel = 0,
            Parent = Gear,
        })
        S(Tooth, "BackgroundColor3", "DarkText")
    end
    return Gear
end

-- // --------------------------------------------------- banana icon (real png)
--
-- The brand icon is a real 128x128 flat-design banana PNG, embedded below as
-- base64. On executors with writefile/getcustomasset it is written once into
-- the workspace folder and loaded as a custom asset; if that is unavailable
-- the library falls back to the pure-frame vector banana further down, so the
-- icon always renders. You can also pass your own decal via CreateWindow's
-- Icon = "rbxassetid://..." option.

local function Base64Decode(Source)
    local Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local Lookup = {}
    for I = 1, #Alphabet do
        Lookup[Alphabet:sub(I, I)] = I - 1
    end
    Source = Source:gsub("%s", "")
    local Out = {}
    local I = 1
    while I <= #Source do
        local Chunk = Source:sub(I, I + 3)
        local A = Lookup[Chunk:sub(1, 1)] or 0
        local B = Lookup[Chunk:sub(2, 2)] or 0
        local C = Lookup[Chunk:sub(3, 3)] or 0
        local D = Lookup[Chunk:sub(4, 4)] or 0
        if #Chunk >= 2 then
            table.insert(Out, string.char((A * 4 + math.floor(B / 16)) % 256))
        end
        if #Chunk >= 3 and Chunk:sub(3, 3) ~= "=" then
            table.insert(Out, string.char((B % 16) * 16 + math.floor(C / 4)))
        end
        if #Chunk >= 4 and Chunk:sub(4, 4) ~= "=" then
            table.insert(Out, string.char((C % 4) * 64 + D))
        end
        I = I + 4
    end
    return table.concat(Out)
end

