local function FadeOutInstance(Inst, Time)
    if Inst:IsA("Frame") then
        Tween(Inst, Time, { BackgroundTransparency = 1 })
    elseif Inst:IsA("TextLabel") then
        Tween(Inst, Time, { TextTransparency = 1 })
    elseif Inst:IsA("ImageLabel") then
        Tween(Inst, Time, { ImageTransparency = 1 })
    end
    for _, Child in ipairs(Inst:GetChildren()) do
        FadeOutInstance(Child, Time)
    end
    local Stroke = Inst:FindFirstChildOfClass("UIStroke")
    if Stroke then
        Tween(Stroke, Time, { Transparency = 1 })
    end
end

