function Library:Notify(...)
    Library:InitHUDArea()
    local Data = {}
    local Info = select(1, ...)

    if type(Info) == "table" then
        Data.Title = Info.Title ~= nil and tostring(Info.Title) or nil
        Data.TitleColor = Info.TitleColor
        Data.Description = Info.Description ~= nil and tostring(Info.Description) or nil
        Data.DescriptionColor = Info.DescriptionColor
        Data.Time = Info.Time or 5
        Data.SoundId = Info.SoundId
        Data.Volume = tonumber(Info.Volume) or 3
        Data.Icon = Info.Icon
        Data.IconColor = Info.IconColor
    else
        Data.Description = tostring(Info)
        Data.Time = select(2, ...) or 5
        Data.SoundId = select(3, ...)
        Data.Volume = select(4, ...) or 3
    end

    if Data.SoundId then
        pcall(function()
            local SoundService = game:GetService("SoundService")
            local Sound = Instance.new("Sound")
            Sound.SoundId = (type(Data.SoundId) == "number")
                and ("rbxassetid://" .. tostring(Data.SoundId))
                or tostring(Data.SoundId)
            Sound.Volume = Data.Volume / 10
            Sound.Parent = SoundService
            SoundService:PlayLocalSound(Sound)
            task.delay(10, function()
                Sound:Destroy()
            end)
        end)
    end

    local Area = Library.NotificationArea

    -- obsidian notification: MainColor panel, outline, 8px padding,
    -- 15px title / 14px description, slides in from the edge
    local Entry = New("Frame", {
        BackgroundColor3 = Library.Scheme.MainColor,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = 5,
        Parent = Area,
    })
    S(Entry, "BackgroundColor3", "MainColor")
    RegCorner(Entry, Library.CornerRadius)
    local EStroke = New("UIStroke", { Thickness = 1, Parent = Entry })
    S(EStroke, "Color", "OutlineColor")

    local ContentHolder = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = 6,
        Parent = Entry,
    })
    New("UIListLayout", {
        Padding = UDim.new(0, 4),
        Parent = ContentHolder,
    })
    New("UIPadding", {
        PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
        PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
        Parent = ContentHolder,
    })

    local TextContainer = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = 6,
        Parent = ContentHolder,
    })
    New("UIListLayout", { Padding = UDim.new(0, 4), Parent = TextContainer })

    local FadeTargets = { Entry }
    if Data.Title then
        local Title = New("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Font = F.Row,
            TextSize = 15,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true,
            Text = Data.Title,
            TextColor3 = Data.TitleColor or Library.Scheme.FontColor,
            ZIndex = 7,
            Parent = TextContainer,
        })
        table.insert(FadeTargets, Title)
    end
    if Data.Description then
        local Desc = New("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Font = F.Small,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true,
            Text = Data.Description,
            TextColor3 = Data.DescriptionColor or Library.Scheme.FontColor,
            ZIndex = 7,
            Parent = TextContainer,
        })
        table.insert(FadeTargets, Desc)
    end

    -- cap the stack at 6
    local Count = 0
    for _, Child in ipairs(Area:GetChildren()) do
        if Child:IsA("Frame") then
            Count = Count + 1
        end
    end
    if Count > 6 then
        for _, Child in ipairs(Area:GetChildren()) do
            if Child:IsA("Frame") and Count > 6 then
                FadeOutInstance(Child, 0.25)
                task.delay(0.3, function()
                    Child:Destroy()
                end)
                Count = Count - 1
            end
        end
    end

    -- slide in from the edge + fade
    local FromRight = Library.NotifySide ~= "Left"
    Entry.Position = UDim2.new(0, FromRight and 60 or -60, 0, 0)
    Entry.BackgroundTransparency = 1
    EStroke.Transparency = 1
    for _, Label in ipairs(FadeTargets) do
        if Label:IsA("TextLabel") then
            Label.TextTransparency = 1
        end
    end
    task.defer(function()
        Tween(Entry, 0.18, { Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 0 })
        Tween(EStroke, 0.18, { Transparency = 0 })
        for _, Label in ipairs(FadeTargets) do
            if Label:IsA("TextLabel") then
                Tween(Label, 0.18, { TextTransparency = 0 })
            end
        end
    end)

    local Dismissed = false
    local function Dismiss()
        if Dismissed then
            return
        end
        Dismissed = true
        Tween(Entry, 0.25, { Position = UDim2.new(0, FromRight and 60 or -60, 0, 0) })
        FadeOutInstance(Entry, 0.25)
        task.delay(0.3, function()
            Entry:Destroy()
        end)
    end

    if typeof and typeof(Data.Time) == "Instance" then
        task.spawn(function()
            while not Dismissed and Data.Time.Parent do
                task.wait(0.25)
            end
            Dismiss()
        end)
    else
        task.delay(tonumber(Data.Time) or 5, Dismiss)
    end

    return {
        Destroy = Dismiss,
        Instance = Entry,
    }
end
